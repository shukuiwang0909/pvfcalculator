          <a href="/zh/valve-cv-calculator/" class="inline-flex items-center gap-2 rounded-xl border border-theme px-8 py-3.5 text-sm font-bold text-theme-primary hover:bg-theme-secondary transition">
            阀门 Cv 计算器
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div id="faq">
        <h2 class="text-2xl font-bold text-theme-primary mb-6">常见问题</h2>
        <div class="space-y-4">
          {faqItems.map(item => (
            <details class="glass rounded-xl px-5 py-4 group">
              <summary class="flex items-center justify-between cursor-pointer font-semibold text-theme-primary">
                {item.question}
                <svg class="h-5 w-5 accent-text transition-transform group-open:rotate-180 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-theme-secondary">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- Related -->
      <div class="border-t border-theme pt-8">
        <h3 class="font-bold text-theme-primary mb-3">相关工具与资源</h3>
        <div class="flex flex-wrap gap-3">
          <a href="/zh/valve-weight-calculator/" class="rounded-full border border-theme px-4 py-1.5 text-sm text-theme-primary hover:bg-theme-secondary transition">阀门重量计算器</a>
          <a href="/zh/valve-cv-calculator/" class="rounded-full border border-theme px-4 py-1.5 text-sm text-theme-primary hover:bg-theme-secondary transition">阀门 Cv 计算器</a>
          <a href="/cangzhou-flange-manufacturers/" class="rounded-full border border-theme px-4 py-1.5 text-sm text-theme-primary hover:bg-theme-secondary transition">沧州法兰制造商</a>
