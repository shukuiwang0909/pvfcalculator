        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/zh/request-a-quote/" class="inline-flex items-center gap-2 accent-bg hover:opacity-90 rounded-xl px-8 py-3.5 text-sm font-bold shadow-lg transition" style="color: #07090c;">
            立即询价 →
          </a>
          <a href="/zh/valve-weight-calculator/" class="inline-flex items-center gap-2 rounded-xl border border-theme px-8 py-3.5 text-sm font-bold text-theme-primary hover:bg-theme-secondary transition">
            阀门重量计算器
