---
import Base from "../../../layouts/Base.astro";
import factoriesJson from "../../../data/factories.json";

interface Factory {
  slug: string;
  name: string;
  nameZh?: string;
  tier: "listed" | "verified";
  products: string[];
  standards: string[];
  materials: string[];
  city: string;
  province: string;
  website?: string;
  description: string;
  founded?: number;
  certifications?: string[];
  exportMarkets?: string[];
}

const factories = factoriesJson as unknown as Factory[];

const title = "孟村管件工厂目录 | PVF Calculator";
const description =
  "孟村及沧州河北地区管件法兰制造商名录，涵盖产品范围、执行标准（ASME B16.5/B16.9、DIN、JIS）、材质及认证信息。";
const canonical = "https://pvfcalculator.com/zh/factories/";

const breadcrumbItems = [
  { name: "首页", url: "/zh/" },
  { name: "工厂目录", url: "/zh/factories/" },
];
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbItems={breadcrumbItems}
  lang="zh"
>
  <div class="max-w-6xl mx-auto px-4 py-10 sm:py-16">

    <!-- Header -->
    <div class="mb-10">
      <nav class="text-sm text-gray-500 mb-6 flex items-center gap-1">
        <a href="/zh/" class="hover:text-amber-400 transition-colors">首页</a>
        <span class="mx-1">›</span>
        <span class="text-gray-300">工厂目录</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">孟村管件制造商目录</h1>
      <p class="text-gray-400 max-w-2xl leading-relaxed">
        {factories.length} 家孟村及沧州河北地区管件制造商——中国 ASME B16.9 对焊管件及 B16.5 法兰的主要产业集群。所有收录信息免费，不设排名。
      </p>
    </div>

    <!-- Claim banner -->
    <div class="bg-gray-900 border border-amber-400/30 rounded-xl p-5 mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <p class="font-semibold text-white mb-1">您是孟村或沧州的管件制造商？</p>
        <p class="text-sm text-gray-400">免费收录，让海外工程师和采购商直接找到您。</p>
      </div>
      <a href="/zh/request-a-quote/" class="shrink-0 inline-block px-5 py-2.5 bg-amber-400 hover:bg-amber-300 text-black text-sm font-semibold rounded-lg transition-colors">
        申请收录 →
      </a>
    </div>

    <!-- Factory grid -->
    <div class="grid md:grid-cols-2 gap-5">
      {factories.map((factory) => (
        <a
          href={`/zh/factories/${factory.slug}/`}
          class="group block bg-gray-900 border border-gray-800 hover:border-amber-400/40 rounded-xl p-6 transition-colors"
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <h2 class="font-semibold text-white group-hover:text-amber-400 transition-colors leading-tight">
                {factory.nameZh || factory.name}
              </h2>
              <p class="text-gray-500 text-sm mt-0.5">{factory.name}</p>
            </div>
            <span class="shrink-0 text-xs px-2 py-0.5 rounded-full border border-gray-700 text-gray-500 mt-0.5">
              免费收录
            </span>
          </div>

          <p class="text-gray-400 text-sm leading-relaxed mb-4 line-clamp-2">{factory.description}</p>

          <div class="flex flex-wrap gap-1.5 mb-3">
            {factory.products.slice(0, 4).map((p) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-gray-800 border border-gray-700 text-gray-400">{p}</span>
            ))}
          </div>

          <div class="flex items-center justify-between text-xs text-gray-600">
            <span>{factory.city}，{factory.province}</span>
            {factory.founded && <span>成立于 {factory.founded} 年</span>}
          </div>
        </a>
      ))}
    </div>

    <!-- Calculator cross-link -->
    <div class="mt-12 bg-gray-900 border border-gray-800 rounded-xl p-6">
      <p class="font-semibold text-white mb-1">下单前先算重量</p>
      <p class="text-gray-400 text-sm mb-4">使用免费计算器核验运输重量，整理物料清单。</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/zh/flange-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">法兰重量计算器 →</a>
        <a href="/zh/elbow-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">弯头重量计算器 →</a>
        <a href="/zh/tee-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">三通重量计算器 →</a>
        <a href="/zh/reducer-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">大小头重量计算器 →</a>
        <a href="/zh/pipe-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">管道重量计算器 →</a>
      </div>
    </div>

    <p class="mt-8 text-xs text-gray-600">
      PVFCalculator 收录制造商信息仅供参考，付款前请独立核实供应商资质。
      详见 <a href="/zh/mengcun-pipe-fittings/" class="underline hover:text-gray-400">孟村管件采购指南</a>。
    </p>

  </div>
</Base>
