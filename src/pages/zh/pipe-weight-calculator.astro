---
import Base from "../../layouts/Base.astro";
import { PIPE_DATA, getAvailableSchedules } from "../../data/pipe-dimensions";

const title = "管道重量计算器（ASME B36.10M）| 各壁厚等级 | pvfcalculator.com";
const description = "免费 ASME B36.10M 管道重量计算器。可计算各公称管径（NPS）与壁厚等级（SCH 10–XXS）的每米重量及总重量，支持碳钢、不锈钢及自定义密度材质。";
const canonical = "https://pvfcalculator.com/zh/pipe-weight-calculator/";

// Build schedule options for JS
const npsData = PIPE_DATA.map(p => ({
  nps: p.nps,
  label: p.label,
  od: p.od,
  schedules: p.schedules.filter(s => s.wallThickness > 0).map(s => ({
    id: s.id,
    label: s.label,
    t: s.wallThickness,
  })),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "管道重量计算器",
  "url": canonical,
  "description": description,
  "applicationCategory": "EngineeringApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
};
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "STD、XS 与 SCH 40 有什么区别？", "acceptedAnswer": { "@type": "Answer", "text": "对于 NPS 1/8\" 至 10\" 的管道，STD（标准）与 SCH 40 壁厚相同。NPS 12\" 及以上时，STD 壁厚薄于 SCH 40。XS（加强型）在 NPS 8\" 及以下等同于 SCH 80，但对于更大管径则厚于 SCH 80。" } },
    { "@type": "Question", "name": "此管道重量计算器的精度如何？", "acceptedAnswer": { "@type": "Answer", "text": "本计算器采用 ASME B36.10M 标准精确尺寸及理论公式进行计算。由于制造公差（通常为 ±5–10%），实际重量可能略有偏差。用于运输或结构计算时，请以实际测量值为准。" } },
    { "@type": "Question", "name": "碳钢管道的密度是多少？", "acceptedAnswer": { "@type": "Answer", "text": "标准碳钢（A106、A53、A105）的密度约为 7850 kg/m³（0.284 lb/in³）。304 不锈钢约为 8000 kg/m³，316 不锈钢约为 7980 kg/m³。" } },
    { "@type": "Question", "name": "能否计算自定义材质的管道重量？", "acceptedAnswer": { "@type": "Answer", "text": "可以。在材质下拉菜单中选择「自定义密度」，然后输入材质的密度（kg/m³）。适用于合金钢、铝、铜或塑料管道等特殊材质。" } },
  ],
};
const breadcrumbItems = [
  { name: "首页", url: "/zh/" },
  { name: "管道重量计算器", url: "/zh/pipe-weight-calculator/" },
];
---

<Base lang="zh" title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd, jsonLd]} breadcrumbItems={breadcrumbItems} ctaHref="#calculator">
  <section class="relative overflow-hidden py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-theme bg-theme-secondary px-4 py-1.5 text-sm font-medium text-theme-secondary mb-4">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full accent-bg"></span>
          </span>
          ASME B36.10M · 免费工具
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-theme-primary">
          管道 <span class="accent-text">重量计算器</span>
        </h1>
        <p class="mt-4 text-lg text-theme-secondary max-w-2xl mx-auto">
          计算任意公称管径（NPS）与壁厚等级的每米重量及总重量。
          支持碳钢、不锈钢及自定义材质。
        </p>
      </div>

      <!-- Calculator Card -->
      <div id="calculator" class="rounded-2xl border border-theme bg-theme-secondary p-6 sm:p-8 shadow-xl">
        <form id="pipeCalc" class="space-y-6">
          <!-- NPS Selection -->
          <div>
            <label for="nps" class="block text-sm font-semibold text-theme-primary mb-2">
              NPS（公称管径）
            </label>
            <select id="nps" name="nps" class="w-full rounded-lg border border-theme bg-theme px-4 py-3 text-theme-primary focus:outline-none focus:ring-2 focus:ring-amber-500">
              {PIPE_DATA.map(p => (
                <option value={p.nps}>{p.label} - OD {p.od}mm</option>
              ))}
            </select>
          </div>

          <!-- Schedule Selection -->
          <div>
            <label for="schedule" class="block text-sm font-semibold text-theme-primary mb-2">
              壁厚等级
            </label>
            <select id="schedule" name="schedule" class="w-full rounded-lg border border-theme bg-theme px-4 py-3 text-theme-primary focus:outline-none focus:ring-2 focus:ring-amber-500">
              <!-- Populated by JS -->
            </select>
          </div>

          <!-- Length Input -->
          <div>
            <label for="length" class="block text-sm font-semibold text-theme-primary mb-2">
              长度（米）
            </label>
            <input
              type="number"
              id="length"
              name="length"
              value="6"
              min="0.1"
              step="0.1"
              class="w-full rounded-lg border border-theme bg-theme px-4 py-3 text-theme-primary focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>

          <!-- Material Selection -->
          <div>
            <label for="material" class="block text-sm font-semibold text-theme-primary mb-2">
              材质
            </label>
            <select id="material" name="material" class="w-full rounded-lg border border-theme bg-theme px-4 py-3 text-theme-primary focus:outline-none focus:ring-2 focus:ring-amber-500">
              <option value="7850">碳钢（A106 / A53）- 7850 kg/m³</option>
              <option value="8000">不锈钢 304 - 8000 kg/m³</option>
              <option value="7980">不锈钢 316 - 7980 kg/m³</option>
              <option value="7750">合金钢（P11 / P22）- 7750 kg/m³</option>
              <option value="2700">铝 - 2700 kg/m³</option>
              <option value="custom">自定义密度</option>
            </select>
          </div>

          <!-- Custom Density (hidden by default) -->
          <div id="customDensityDiv" class="hidden">
            <label for="customDensity" class="block text-sm font-semibold text-theme-primary mb-2">
              自定义密度（kg/m³）
            </label>
            <input
              type="number"
              id="customDensity"
              name="customDensity"
              value="7850"
              min="100"
              max="25000"
              class="w-full rounded-lg border border-theme bg-theme px-4 py-3 text-theme-primary focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>

          <!-- Calculate Button -->
          <button
            type="submit"
            class="w-full accent-bg hover:opacity-90 rounded-xl px-8 py-4 text-sm font-bold shadow-lg transition"
            style="color: #07090c;"
          >
            计算
          </button>
        </form>

        <!-- Results Section -->
        <div id="results" class="mt-8 pt-8 border-t border-theme hidden">
          <h3 class="text-xl font-bold text-theme-primary mb-4">计算结果</h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Pipe Specs -->
            <div class="rounded-xl bg-theme p-4 border border-theme">
              <div class="text-sm text-theme-secondary mb-1">管道规格</div>
              <div class="text-lg font-semibold text-theme-primary" id="resultSpecs">-</div>
              <div class="text-sm text-theme-secondary mt-1" id="resultDims">-</div>
            </div>

            <!-- Weight per Meter -->
            <div class="rounded-xl bg-theme p-4 border border-theme">
              <div class="text-sm text-theme-secondary mb-1">每米重量</div>
              <div class="text-2xl font-bold accent-text" id="resultWeightPerM">-</div>
              <div class="text-sm text-theme-secondary">kg/m</div>
            </div>

            <!-- Total Weight -->
            <div class="rounded-xl bg-theme p-4 border border-theme sm:col-span-2">
              <div class="text-sm text-theme-secondary mb-1">总重量</div>
              <div class="flex gap-2 mb-3">
                <button id="unitKg" type="button" class="px-3 py-1 rounded-lg text-sm font-semibold border border-theme accent-bg transition" style="color:#07090c">kg</button>
                <button id="unitLb" type="button" class="px-3 py-1 rounded-lg text-sm font-semibold border border-theme hover:bg-theme-secondary transition text-theme-primary">lb</button>
              </div>
              <div class="flex items-baseline gap-4">
                <div class="text-3xl font-bold accent-text" id="resultTotalKg">-</div>
                <div class="text-3xl font-bold accent-text hidden" id="resultTotalLb">-</div>
              </div>
            </div>

            <!-- Volume -->
            <div class="rounded-xl bg-theme p-4 border border-theme sm:col-span-2">
              <div class="text-sm text-theme-secondary mb-1">金属体积</div>
              <div class="text-lg font-semibold text-theme-primary" id="resultVolume">-</div>
            </div>
          </div>
          <!-- Copy & Share -->
          <div class="mt-4 flex gap-3 justify-end">
            <button id="copyBtn" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-theme bg-theme px-4 py-2 text-sm font-semibold text-theme-primary transition hover:bg-theme-secondary">
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
              <span id="copyBtnLabel">复制结果</span>
            </button>
            <button id="shareBtn" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-theme bg-theme px-4 py-2 text-sm font-semibold text-theme-primary transition hover:bg-theme-secondary">
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
              <span id="shareBtnLabel">分享链接</span>
            </button>
          </div>
        </div>
      </div>

      <!-- How to Use -->
      <div class="mt-12 rounded-2xl border border-theme bg-theme-secondary p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-theme-primary mb-4">如何计算管道重量</h2>
        <div class="prose prose-invert max-w-none text-theme-secondary">
          <p class="mb-4">
            管道重量采用圆环截面公式计算，取决于外径（OD）、壁厚（t）、长度及材质密度。
          </p>

          <h3 class="text-lg font-semibold text-theme-primary mt-6 mb-3">计算公式</h3>
          <div class="rounded-lg bg-theme p-4 border border-theme mb-4">
            <code class="text-amber-400">
              W = (OD - t) × t × 0.02466 × L
            </code>
            <div class="text-sm text-theme-secondary mt-2">
              其中：W = 重量（kg），OD = 外径（mm），t = 壁厚（mm），L = 长度（m）
            </div>
          </div>

          <h3 class="text-lg font-semibold text-theme-primary mt-6 mb-3">计算示例</h3>
          <p class="mb-2">
            以 6" SCH 40 碳钢管，长度 12 米为例：
          </p>
          <ul class="list-disc pl-6 mb-4 space-y-1">
            <li>外径 OD = 168.3 mm</li>
            <li>壁厚（SCH 40）= 7.11 mm</li>
            <li>长度 = 12 m</li>
            <li>密度 = 7850 kg/m³</li>
          </ul>
          <p class="mb-4">
            <strong class="text-theme-primary">计算结果：</strong>每米约 28.3 kg，12 米总重约 339.6 kg。
          </p>

          <h3 class="text-lg font-semibold text-theme-primary mt-6 mb-3">常用壁厚等级</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-theme">
                  <th class="text-left py-2 text-theme-primary">壁厚等级</th>
                  <th class="text-left py-2 text-theme-primary">说明</th>
                </tr>
              </thead>
              <tbody class="text-theme-secondary">
                <tr class="border-b border-theme/50">
                  <td class="py-2 font-medium">STD</td>
                  <td class="py-2">标准型 — NPS ≤ 10" 时与 SCH 40 壁厚相同</td>
                </tr>
                <tr class="border-b border-theme/50">
                  <td class="py-2 font-medium">XS</td>
                  <td class="py-2">加强型 — NPS ≤ 8" 时与 SCH 80 壁厚相同</td>
                </tr>
                <tr class="border-b border-theme/50">
                  <td class="py-2 font-medium">XXS</td>
                  <td class="py-2">双加强型</td>
                </tr>
                <tr class="border-b border-theme/50">
                  <td class="py-2 font-medium">SCH 10 / 20 / 30</td>
                  <td class="py-2">薄壁等级</td>
                </tr>
                <tr class="border-b border-theme/50">
                  <td class="py-2 font-medium">SCH 40 / 60 / 80 / 100 / 120 / 140 / 160</td>
                  <td class="py-2">厚壁等级</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mt-12 rounded-2xl border border-theme bg-theme-secondary p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-theme-primary mb-6">常见问题</h2>

        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-theme-primary mb-2">STD、XS 与 SCH 40 有什么区别？</h3>
            <p class="text-theme-secondary">
              对于 NPS 1/8" 至 10" 的管道，STD（标准）与 SCH 40 壁厚相同。
              NPS 12" 及以上时，STD 壁厚薄于 SCH 40。XS（加强型）在 NPS 8" 及以下
              等同于 SCH 80，但对于更大管径则厚于 SCH 80。
            </p>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-theme-primary mb-2">此管道重量计算器的精度如何？</h3>
            <p class="text-theme-secondary">
              本计算器采用 ASME B36.10M 标准精确尺寸及理论公式进行计算。
              由于制造公差（通常为 ±5–10%），实际重量可能略有偏差。
              用于运输或结构计算时，请务必以实际测量值为准。
            </p>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-theme-primary mb-2">碳钢管道的密度是多少？</h3>
            <p class="text-theme-secondary">
              标准碳钢（A106、A53、A105）的密度约为 7850 kg/m³（0.284 lb/in³）。
              304 不锈钢约为 8000 kg/m³，316 不锈钢约为 7980 kg/m³。
            </p>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-theme-primary mb-2">能否计算自定义材质的管道重量？</h3>
            <p class="text-theme-secondary">
              可以。在材质下拉菜单中选择"自定义密度"，然后输入材质的密度（kg/m³）。
              适用于合金钢、铝、铜或塑料管道等特殊材质。
            </p>
          </div>
        </div>
      </div>

      <!-- Related Tools -->
      <div class="mt-12 rounded-2xl border border-theme bg-theme-secondary p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-theme-primary mb-6">相关计算器</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="/zh/flange-weight-calculator/" class="block rounded-xl bg-theme p-4 border border-theme hover:border-amber-500/50 transition group">
            <div class="font-semibold text-theme-primary group-hover:text-amber-400 transition">法兰重量计算器</div>
            <div class="text-sm text-theme-secondary mt-1">对焊、平焊、盲板、承插焊及螺纹法兰</div>
          </a>
          <a href="/zh/elbow-weight-calculator/" class="block rounded-xl bg-theme p-4 border border-theme hover:border-amber-500/50 transition group">
            <div class="font-semibold text-theme-primary group-hover:text-amber-400 transition">弯头重量计算器</div>
            <div class="text-sm text-theme-secondary mt-1">45° 和 90° 长半径及短半径弯头</div>
          </a>
          <a href="/zh/tee-weight-calculator/" class="block rounded-xl bg-theme p-4 border border-theme hover:border-amber-500/50 transition group">
            <div class="font-semibold text-theme-primary group-hover:text-amber-400 transition">三通重量计算器</div>
            <div class="text-sm text-theme-secondary mt-1">等径和异径对焊三通</div>
          </a>
          <a href="/zh/reducer-weight-calculator/" class="block rounded-xl bg-theme p-4 border border-theme hover:border-amber-500/50 transition group">
            <div class="font-semibold text-theme-primary group-hover:text-amber-400 transition">大小头重量计算器</div>
            <div class="text-sm text-theme-secondary mt-1">同心和偏心大小头</div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ npsData }}>
    // Pipe data embedded from server
    const PIPE_NPS_DATA = npsData;

    // DOM elements
    const npsSelect = document.getElementById('nps');
    const scheduleSelect = document.getElementById('schedule');
    const materialSelect = document.getElementById('material');
    const customDensityDiv = document.getElementById('customDensityDiv');
    const customDensityInput = document.getElementById('customDensity');
    const form = document.getElementById('pipeCalc');
    const resultsDiv = document.getElementById('results');

    // Populate schedules when NPS changes
    function updateSchedules() {
      const nps = parseFloat(npsSelect.value);
      const pipeData = PIPE_NPS_DATA.find(p => p.nps === nps);

      scheduleSelect.innerHTML = '';
      if (pipeData) {
        pipeData.schedules.forEach(s => {
          const opt = document.createElement('option');
          opt.value = s.id;
          opt.textContent = `${s.label} - ${s.t}mm`;
          scheduleSelect.appendChild(opt);
        });
      }
    }

    // Handle material change
    function handleMaterialChange() {
      if (materialSelect.value === 'custom') {
        customDensityDiv.classList.remove('hidden');
      } else {
        customDensityDiv.classList.add('hidden');
      }
    }

    // Calculate
    function calculate(e) {
      e.preventDefault();

      const nps = parseFloat(npsSelect.value);
      const scheduleId = scheduleSelect.value;
      const length = parseFloat(document.getElementById('length').value) || 0;

      let density;
      if (materialSelect.value === 'custom') {
        density = parseFloat(customDensityInput.value) || 7850;
      } else {
        density = parseFloat(materialSelect.value);
      }

      const pipeData = PIPE_NPS_DATA.find(p => p.nps === nps);
      if (!pipeData || length <= 0) return;

      const sched = pipeData.schedules.find(s => s.id === scheduleId);
      if (!sched) return;

      const od = pipeData.od;
      const t = sched.t;
      const id = od - 2 * t;

      // Calculate
      const areaMm2 = (Math.PI / 4) * (od * od - id * id);
      const volumeM3PerM = areaMm2 * 1000 * 1e-9;
      const weightPerMeter = volumeM3PerM * density;
      const totalWeight = weightPerMeter * length;
      const totalWeightLb = totalWeight * 2.20462;
      const volumeM3 = volumeM3PerM * length;

      // Display results
      document.getElementById('resultSpecs').textContent =
        `${pipeData.label} ${sched.label} Pipe`;
      document.getElementById('resultDims').textContent =
        `OD: ${od}mm × WT: ${t}mm × ID: ${id.toFixed(1)}mm`;
      document.getElementById('resultWeightPerM').textContent =
        weightPerMeter.toFixed(2);
      document.getElementById('resultTotalKg').textContent =
        `${totalWeight.toFixed(1)} kg`;
      document.getElementById('resultTotalLb').textContent =
        `${totalWeightLb.toFixed(1)} lb`;
      document.getElementById('resultVolume').textContent =
        `${volumeM3.toFixed(4)} m³`;

      resultsDiv.classList.remove('hidden');
      applyUnit(currentUnit);
      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      // Update share link URL when result is shown
      const sp = new URLSearchParams({
        nps: String(nps), schedule: scheduleId, length: String(length), material: materialSelect.value,
      });
      if (materialSelect.value === 'custom') sp.set('density', String(density));
      history.replaceState(null, '', '?' + sp.toString());
    }

    // Event listeners
    npsSelect.addEventListener('change', updateSchedules);
    materialSelect.addEventListener('change', handleMaterialChange);
    form.addEventListener('submit', calculate);

    // kg/lb unit toggle with localStorage persistence
    const unitKgBtn = document.getElementById('unitKg');
    const unitLbBtn = document.getElementById('unitLb');
    let currentUnit = localStorage.getItem('pvf_unit_pref') || 'kg';

    function applyUnit(unit) {
      currentUnit = unit;
      localStorage.setItem('pvf_unit_pref', unit);
      const isLb = unit === 'lb';
      document.getElementById('resultTotalKg').classList.toggle('hidden', isLb);
      document.getElementById('resultTotalLb').classList.toggle('hidden', !isLb);
      if (isLb) {
        unitLbBtn.classList.add('accent-bg');
        unitLbBtn.style.color = '#07090c';
        unitLbBtn.classList.remove('text-theme-primary', 'hover:bg-theme-secondary');
        unitKgBtn.classList.remove('accent-bg');
        unitKgBtn.removeAttribute('style');
        unitKgBtn.classList.add('text-theme-primary', 'hover:bg-theme-secondary');
      } else {
        unitKgBtn.classList.add('accent-bg');
        unitKgBtn.style.color = '#07090c';
        unitKgBtn.classList.remove('text-theme-primary', 'hover:bg-theme-secondary');
        unitLbBtn.classList.remove('accent-bg');
        unitLbBtn.removeAttribute('style');
        unitLbBtn.classList.add('text-theme-primary', 'hover:bg-theme-secondary');
      }
    }

    applyUnit(currentUnit);
    unitKgBtn.addEventListener('click', () => applyUnit('kg'));
    unitLbBtn.addEventListener('click', () => applyUnit('lb'));

    // Copy Result
    document.getElementById('copyBtn').addEventListener('click', () => {
      const specs = document.getElementById('resultSpecs').textContent ?? '';
      const wpm = document.getElementById('resultWeightPerM').textContent ?? '';
      const weightDisplay = currentUnit === 'lb'
        ? (document.getElementById('resultTotalLb').textContent ?? '')
        : (document.getElementById('resultTotalKg').textContent ?? '');
      const text = `PVF Calculator — Pipe Weight\n${specs}\nWeight per meter: ${wpm} kg/m\nTotal: ${weightDisplay}\nhttps://pvfcalculator.com/zh/pipe-weight-calculator/`;
      navigator.clipboard.writeText(text).then(() => {
        document.getElementById('copyBtnLabel').textContent = '✓ Copied!';
        setTimeout(() => { document.getElementById('copyBtnLabel').textContent = '复制结果'; }, 2000);
      });
    });

    // Share Link
    document.getElementById('shareBtn').addEventListener('click', () => {
      navigator.clipboard.writeText(location.href).then(() => {
        document.getElementById('shareBtnLabel').textContent = '✓ Link copied!';
        setTimeout(() => { document.getElementById('shareBtnLabel').textContent = 'Share Link'; }, 2000);
      });
    });

    // Restore from URL params on load
    const initSp = new URLSearchParams(location.search);
    if (initSp.has('nps')) {
      const npsVal = initSp.get('nps');
      if (npsVal) npsSelect.value = npsVal;
      updateSchedules();
      const schedVal = initSp.get('schedule');
      if (schedVal) {
        Array.from(scheduleSelect.options).forEach(function(opt) { if (opt.value === schedVal) scheduleSelect.value = schedVal; });
      }
      const lenVal = initSp.get('length');
      if (lenVal) document.getElementById('length').value = lenVal;
      const matVal = initSp.get('material');
      if (matVal) { materialSelect.value = matVal; handleMaterialChange(); }
      const densVal = initSp.get('density');
      if (densVal) customDensityInput.value = densVal;
      if (lenVal && Number(lenVal) > 0) calculate({ preventDefault: function() {} });
    } else {
      // Initialize
      updateSchedules();
    }
  </script>
</Base>
