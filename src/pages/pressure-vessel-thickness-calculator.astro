---
import Base from '../layouts/Base.astro';
import { TEMP_ROWS_C, TEMP_ROWS_F, VESSEL_MATERIALS } from '../data/vessel-materials';
const title = "Pressure Vessel Thickness Calculator (ASME VIII Div.1 UG-27/UG-32) | Shell & Heads";
const description = "Free ASME Section VIII Division 1 thickness calculator: cylindrical shells (UG-27, both seam directions), 2:1 ellipsoidal, torispherical and hemispherical heads (UG-32). Allowable stress auto-look-up from II-D tables, weld joint efficiency, corrosion allowance, MAWP back-calculation. Metric & imperial.";
const canonical = "https://pvfcalculator.com/pressure-vessel-thickness-calculator/";

const faqs = [
  {
    q: "How is pressure vessel shell thickness different from pipe schedule wall thickness?",
    a: "They solve different problems. A pipe schedule (ASME B36.10M) is a pre-selected commercial wall thickness standardized per nominal size — it knows nothing about your pressure, temperature, material allowable stress, or weld quality. UG-27 vessel thickness is an engineering calculation: t = P·R/(S·E − 0.6P), where S comes from the ASME II-D allowable stress table at your design temperature and E reflects the radiography of the seam. A SCH 40 pipe may be grossly over- or under-designed for a given vessel duty — the vessel formula sizes the wall for the actual load case."
  },
  {
    q: "Where does the 0.6P term in UG-27 come from?",
    a: "UG-27(c)(1) is not thin-wall theory with a fudge factor — it is the exact Lamé (thick-wall) solution restated. For a cylinder, the maximum hoop stress at the inside surface is σ = P·(R² + Ri²... )/... which the code rewrites as t = P·R/(S·E − 0.6P). The 0.6P in the denominator and the +0.4P in the longitudinal formula are the exact Lamé coefficients for the inside surface, so the formula stays accurate well beyond the t ≤ R/2 limit. That is why UG-27 is valid up to P = 0.385·S·E, far past where a simple 'hoop stress = PR/t' thin-wall formula would be dangerously unconservative."
  },
  {
    q: "What weld joint efficiency (E) should I use?",
    a: "E comes from Table UW-12 and depends on joint type and radiography, not on engineering judgment. For a Type (1) double-welded butt joint: E = 1.00 with full radiography (RT-1, 100% per UW-11), E = 0.85 with spot radiography (RT-2, UW-52), and E = 0.70 with no radiography. Fully radiographed longitudinal seams are the norm for most ASME-stamped process vessels; 0.85 spot RT is common for lower-pressure storage. Vessels in lethal service require full RT by UW-2."
  },
  {
    q: "Is the corrosion allowance included in the MAWP calculation?",
    a: "Yes — MAWP is computed on the corroded thickness (nominal thickness minus corrosion allowance), which is the conservative end-of-life condition. This calculator therefore reports MAWP for the selected nominal plate at your design temperature, using t(corroded) = t(nominal) − CA in the inverted UG-27/UG-32 formulas. The nameplate MAWP on a real vessel is certified by the manufacturer and may also be limited by nozzles, flanges, or the relief valve set pressure."
  },
  {
    q: "Why did the calculator refuse my design temperature?",
    a: "The allowable stress tables in this tool stop at 650°F (343°C). Above that temperature, carbon and low-alloy steels enter the time-dependent (creep) regime, where the allowable stress depends on design life and the values must be read from the latest ASME II-D edition — interpolation or extrapolation from public republished tables is not valid engineering practice. For stainless steels the table extends further; for Cr-Mo steels like SA-387 Gr.11, check II-D directly."
  },
  {
    q: "Does this calculator cover external pressure (vacuum) design?",
    a: "No — external pressure design is deliberately out of scope. Under vacuum, a thin cylinder fails by shell buckling (collapse), not yielding, so thickness follows UG-28 using geometry factors L/Do and Do/t with material curves from Section II Part D Subpart 3, plus stiffening-ring design if needed. If your vessel sees full vacuum or jacket pressure, complete a separate UG-28 calculation; a conservative first estimate is to design the shell for 15 psi external pressure."
  },
  {
    q: "Can I use this calculator for an ASME U-stamp vessel?",
    a: "Use it for scoping, budgeting, and checking fabricator quotes — not as the design of record. Code-stamped vessels must be designed and certified under VIII-1 (or VIII-2) by the manufacturer and reviewed by an Authorized Inspector (AI); the U-stamp is only applied after hydro/pneumatic test and data report sign-off. This tool implements UG-27/UG-32 faithfully but does not handle nozzles (UG-37), fatigue, wind/seismic, MDMT impact (UCS-66), or external pressure."
  },
  {
    q: "Why is the torispherical (F&D) head so much thicker than the 2:1 elliptical head?",
    a: "The 6% knuckle radius of a standard flanged-and-dished head concentrates bending stress at the knuckle, and the UG-32(e) stress multiplier M = ¼(3+√(L/r)) ≈ 1.77 reflects that. A 2:1 semi-elliptical head blends curvature smoothly, keeps K = 1, and typically needs only half the thickness (or less) of an F&D head for the same duty. That is why 2:1 ellipsoidal heads dominate modern vessel design despite slightly higher forming cost."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Pressure Vessel Thickness Calculator (ASME VIII Div.1)",
  "url": canonical,
  "applicationCategory": "EngineeringApplication",
  "operatingSystem": "Any (web browser)",
  "description": description,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": { "@type": "Organization", "name": "pvfcalculator.com", "url": "https://pvfcalculator.com/" }
};
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Pressure Vessel Thickness Calculator", url: "/pressure-vessel-thickness-calculator/" },
];
---
<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd, appJsonLd]} breadcrumbItems={breadcrumbItems} ctaHref="#tool">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
    <!-- Hero -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-theme-primary sm:text-4xl">
        Pressure Vessel Thickness Calculator <span class="accent-text">(ASME VIII Div.1)</span>
      </h1>
      <p class="mt-3 max-w-3xl text-theme-secondary">
        Design wall thickness for cylindrical shells (<strong>UG-27</strong>, both seam directions) and formed heads —
        2:1 ellipsoidal, torispherical (F&amp;D) and hemispherical (<strong>UG-32</strong>).
        Allowable stress is auto-looked-up from ASME II-D tables at your design temperature, with weld joint
        efficiency (UW-12), corrosion allowance, standard plate rounding and <strong>MAWP back-calculation</strong>.
        This is the deepest ASME tooling on the site — the same equations a pressure-vessel designer runs before
        a U-stamp job goes to an ASME shop.
      </p>
    </div>

    <!-- Tool -->
    <section id="tool" class="card p-4 sm:p-6" aria-label="Pressure vessel thickness calculator tool">
      <!-- Component selector -->
      <div class="mb-5">
        <label class="mb-2 block text-sm font-semibold text-theme-secondary">Component</label>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" id="compButtons">
          <button data-comp="shell" class="comp-btn flex flex-col items-center gap-1 rounded-xl border-2 p-3 text-center transition">
            <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><rect x="6" y="10" width="52" height="20" fill="none" stroke="currentColor" stroke-width="2"/><line x1="6" y1="14" x2="58" y2="14" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3"/><line x1="6" y1="26" x2="58" y2="26" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3"/></svg>
            <span class="text-xs font-semibold">Cylindrical Shell</span>
          </button>
          <button data-comp="ellipsoidal21" class="comp-btn flex flex-col items-center gap-1 rounded-xl border-2 p-3 text-center transition">
            <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><line x1="4" y1="10" x2="60" y2="10" stroke="currentColor" stroke-width="2"/><path d="M8 10 A24 16 0 0 0 56 10" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            <span class="text-xs font-semibold">2:1 Ellipsoidal Head</span>
          </button>
          <button data-comp="torispherical" class="comp-btn flex flex-col items-center gap-1 rounded-xl border-2 p-3 text-center transition">
            <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><line x1="4" y1="10" x2="60" y2="10" stroke="currentColor" stroke-width="2"/><path d="M8 10 A30 30 0 0 0 44 26" fill="none" stroke="currentColor" stroke-width="2"/><path d="M44 26 A4 4 0 0 0 56 10" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            <span class="text-xs font-semibold">Torispherical (F&amp;D)</span>
          </button>
          <button data-comp="hemispherical" class="comp-btn flex flex-col items-center gap-1 rounded-xl border-2 p-3 text-center transition">
            <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><line x1="4" y1="10" x2="60" y2="10" stroke="currentColor" stroke-width="2"/><path d="M12 10 A20 20 0 0 0 52 10" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            <span class="text-xs font-semibold">Hemispherical Head</span>
          </button>
        </div>
        <p class="mt-1 text-xs text-theme-muted" id="compDesc">UG-27 — checked in both seam directions</p>
      </div>

      <!-- Inputs -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <label class="mb-1 block text-sm font-semibold text-theme-secondary">Size Basis</label>
          <div class="flex overflow-hidden rounded-lg border border-theme" role="group" aria-label="Diameter or radius">
            <button id="modeId" class="mode-btn flex-1 px-3 py-2 text-sm font-semibold transition">Inside Diameter</button>
            <button id="modeIr" class="mode-btn flex-1 px-3 py-2 text-sm font-semibold transition">Inside Radius</button>
          </div>
        </div>
        <div>
          <label for="dimVal" class="mb-1 block text-sm font-semibold text-theme-secondary"><span id="dimLabel">Inside Diameter</span> (<span class="dim-unit">mm</span>)</label>
          <input id="dimVal" type="number" min="1" max="20000" step="any" value="2000" class="field w-full rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="pressure" class="mb-1 block text-sm font-semibold text-theme-secondary">Design Pressure (<span class="p-unit">MPa</span>)</label>
          <input id="pressure" type="number" min="0.001" max="100" step="any" value="1.0" class="field w-full rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="temp" class="mb-1 block text-sm font-semibold text-theme-secondary">Design Temp (<span id="tempUnit">°C</span>)</label>
          <input id="temp" type="number" min="-50" max="400" step="1" value="100" class="field w-full rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="material" class="mb-1 block text-sm font-semibold text-theme-secondary">Material (II-D lookup)</label>
          <select id="material" class="field w-full rounded-lg px-3 py-2 text-sm"></select>
        </div>
        <div>
          <label for="jeff" class="mb-1 block text-sm font-semibold text-theme-secondary">Weld Joint Efficiency E</label>
          <select id="jeff" class="field w-full rounded-lg px-3 py-2 text-sm"></select>
        </div>
        <div>
          <label for="ca" class="mb-1 block text-sm font-semibold text-theme-secondary">Corrosion Allowance (<span class="dim-unit">mm</span>)</label>
          <input id="ca" type="number" min="0" max="50" step="any" value="1.5" class="field w-full rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-theme-secondary">Units</label>
          <div class="flex overflow-hidden rounded-lg border border-theme" role="group" aria-label="Unit system">
            <button id="unitMetric" class="unit-btn flex-1 px-3 py-2 text-sm font-semibold transition">Metric</button>
            <button id="unitImperial" class="unit-btn flex-1 px-3 py-2 text-sm font-semibold transition">Imperial</button>
          </div>
        </div>
        <div id="toriRow" class="hidden gap-4 sm:col-span-2 lg:col-span-4 lg:grid lg:grid-cols-2">
          <div>
            <label for="crownL" class="mb-1 block text-sm font-semibold text-theme-secondary">Crown Radius L (<span class="dim-unit">mm</span>, blank = ID)</label>
            <input id="crownL" type="number" min="0" step="any" placeholder="= Inside Diameter" class="field w-full rounded-lg px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="knuckR" class="mb-1 block text-sm font-semibold text-theme-secondary">Knuckle Radius r (<span class="dim-unit">mm</span>, blank = 6%·L)</label>
            <input id="knuckR" type="number" min="0" step="any" placeholder="= 6% × L (standard F&D)" class="field w-full rounded-lg px-3 py-2 text-sm" />
          </div>
        </div>
      </div>

      <!-- Results -->
      <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
        <div class="result-panel rounded-xl p-5 lg:col-span-1">
          <p class="text-xs font-medium uppercase tracking-wider text-theme-muted">Required Thickness (incl. CA)</p>
          <p class="mt-2 text-4xl font-extrabold tabular-nums">
            <span id="tValue">–</span>
            <span class="ml-1 text-xl font-semibold accent-text" id="tUnit">mm</span>
          </p>
          <p class="mt-3 text-sm text-theme-secondary"><span id="resultLine">–</span></p>
          <div class="mt-4 border-t border-theme pt-3 text-sm">
            <div class="flex justify-between py-1"><span class="text-theme-muted">Design t (formula)</span><span class="font-semibold" id="outTdesign">–</span></div>
            <div class="flex justify-between py-1"><span class="text-theme-muted">+ Corrosion allowance</span><span class="font-semibold" id="outTca">–</span></div>
            <div class="flex justify-between py-1"><span class="text-theme-muted">Nominal plate (std series)</span><span class="font-semibold accent-text" id="outNominal">–</span></div>
            <div class="flex justify-between py-1"><span class="text-theme-muted">MAWP @ design T</span><span class="font-semibold" id="outMawp">–</span></div>
            <div class="flex justify-between py-1"><span class="text-theme-muted">Allowable stress S (looked-up)</span><span class="font-semibold" id="outS">–</span></div>
            <div class="flex justify-between py-1"><span class="text-theme-muted">UG-16(b) min after forming</span><span class="font-semibold" id="outUg16">–</span></div>
          </div>
          <div id="warnBox" class="mt-3 hidden rounded-lg border border-amber-500/40 bg-amber-500/10 p-3 text-xs leading-relaxed text-theme-secondary"></div>
        </div>

        <div class="card lg:col-span-1">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-theme-muted">Seam-by-Seam Detail</p>
          <dl class="text-sm" id="seamList"></dl>
          <details class="mt-3 text-xs text-theme-muted">
            <summary class="cursor-pointer font-medium accent-text hover:underline">UW-12 joint efficiency basis</summary>
            <p class="mt-1">E applies to the welded seam being checked: the UG-27 circumferential-stress (longitudinal seam) formula uses the Category A seam efficiency; the axial-stress formula uses the Category B (circumferential) seam. RT-1 full radiography = 1.00, RT-2 spot = 0.85, none = 0.70 (UW-12 Type 1 butt joints).</p>
          </details>
        </div>

        <div class="card lg:col-span-1">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-theme-muted">Geometry &amp; Data Source</p>
          <dl class="text-sm" id="geomList"></dl>
          <details class="mt-3 text-xs text-theme-muted">
            <summary class="cursor-pointer font-medium accent-text hover:underline">Allowable stress source</summary>
            <p class="mt-1">S is linearly interpolated from publicly republished ASME BPVC II-D Table 1A values at 100–650°F (see the table below). Verify against your edition of II-D before design use.</p>
          </details>
        </div>
      </div>

      <!-- Copy & Share -->
      <div class="mt-4 flex gap-3 justify-end">
        <button id="copyBtn" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-theme bg-theme px-4 py-2 text-sm font-semibold text-theme-primary transition hover:bg-theme-secondary">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 01-2-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          <span id="copyBtnLabel">Copy Result</span>
        </button>
        <button id="shareBtn" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-theme bg-theme px-4 py-2 text-sm font-semibold text-theme-primary transition hover:bg-theme-secondary">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
          <span id="shareBtnLabel">Share Link</span>
        </button>
      </div>
    </section>

    <!-- Full allowable stress table -->
    <section class="mt-10" aria-label="Allowable stress table">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-bold text-theme-primary">ASME II-D Allowable Stress Table <span class="accent-text">(S, public republished values)</span></h2>
        <div class="flex overflow-hidden rounded-lg border border-theme" role="group" aria-label="Stress unit">
          <button id="tabMpa" class="tab-btn px-3 py-1.5 text-xs font-semibold transition">MPa</button>
          <button id="tabKsi" class="tab-btn px-3 py-1.5 text-xs font-semibold transition">ksi</button>
        </div>
      </div>
      <div class="overflow-x-auto rounded-xl bg-theme-card shadow-md">
        <table class="w-full min-w-[720px] text-sm">
          <thead class="bg-ink-900 text-left text-xs uppercase tracking-wider text-theme-secondary">
            <tr>
              <th class="px-3 py-2.5">Material</th>
              {TEMP_ROWS_F.map((f, i) => (
                <th class="px-3 py-2.5 text-center">{f}°F<br /><span class="font-normal normal-case text-theme-muted">≈ {TEMP_ROWS_C[i]}°C</span></th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-theme">
            {VESSEL_MATERIALS.map((m) => (
              <tr class="cursor-pointer hover-accent-light" data-mat={m.id}>
                <td class="px-3 py-2">
                  <span class="font-semibold">{m.name}</span>
                  <span class="block text-xs text-theme-muted">{m.form}</span>
                </td>
                {m.stressMpa.map((v, i) => (
                  <td class="px-3 py-2 text-center tabular-nums" data-mpa={v} data-ksi={m.stressKsi[i]}>
                    <span class="cell-val">{v}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-theme-muted">
        Click a material row to load it into the calculator. Values are publicly republished II-D figures — always confirm with the latest code edition for design.
      </p>
    </section>

    <!-- Methodology -->
    <section class="mt-12" aria-label="Calculation methodology">
      <h2 class="mb-3 text-xl font-bold text-theme-primary">How the calculation works <span class="accent-text">(UG-27 / UG-32, step by step)</span></h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="card">
          <svg viewBox="0 0 420 240" class="w-full" role="img" aria-label="Cylindrical shell variables under internal pressure">
            <defs>
              <marker id="varr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="#64748b" />
              </marker>
            </defs>
            <!-- shell walls -->
            <rect x="60" y="40" width="300" height="160" fill="none" stroke="#b45309" stroke-width="2" />
            <line x1="60" y1="46" x2="360" y2="46" stroke="#f59e0b" stroke-width="3" />
            <line x1="60" y1="194" x2="360" y2="194" stroke="#f59e0b" stroke-width="3" />
            <!-- pressure arrows -->
            <line x1="110" y1="80" x2="110" y2="150" stroke="#64748b" marker-end="url(#varr)" />
            <line x1="180" y1="80" x2="180" y2="150" stroke="#64748b" marker-end="url(#varr)" />
            <line x1="250" y1="80" x2="250" y2="150" stroke="#64748b" marker-end="url(#varr)" />
            <line x1="320" y1="80" x2="320" y2="150" stroke="#64748b" marker-end="url(#varr)" />
            <text x="210" y="126" font-size="16" fill="#334155" text-anchor="middle" font-style="italic">P (internal)</text>
            <!-- centerline -->
            <line x1="30" y1="120" x2="390" y2="120" stroke="#475569" stroke-width="1" stroke-dasharray="8 5" />
            <!-- R dimension -->
            <line x1="36" y1="120" x2="60" y2="120" stroke="#64748b" marker-start="url(#varr)" marker-end="url(#varr)" />
            <text x="46" y="112" font-size="12" fill="#334155" text-anchor="middle" font-style="italic">R</text>
            <!-- t callout -->
            <line x1="392" y1="40" x2="392" y2="46" stroke="#64748b" marker-start="url(#varr)" marker-end="url(#varr)" />
            <text x="404" y="46" font-size="12" fill="#334155" font-style="italic">t</text>
            <text x="60" y="30" font-size="12" fill="#92400e">Inside radius R, wall t, pressure P</text>
            <text x="60" y="222" font-size="12" fill="#334155">Longitudinal seam (Category A) → hoop stress formula</text>
            <text x="60" y="238" font-size="12" fill="#334155">Circumferential seam (Category B) → axial stress formula</text>
          </svg>
        </div>
        <div class="card text-sm leading-relaxed text-theme-secondary">
          <p class="font-semibold text-theme-primary">Code equations implemented</p>
          <ul class="mt-2 list-disc space-y-1.5 pl-5">
            <li><strong>Shell, circumferential stress</strong> (UG-27(c)(1)): t = P·R / (S·E − 0.6P) — governs for typical welds</li>
            <li><strong>Shell, longitudinal stress</strong> (UG-27(c)(2)): t = P·R / (2S·E + 0.4P)</li>
            <li><strong>2:1 ellipsoidal head</strong> (UG-32(d), K=1): t = P·D / (2S·E − 0.2P), = P·L/(2SE−0.2P) with L = 0.9D</li>
            <li><strong>Torispherical head</strong> (UG-32(e)): t = 0.885·P·L·M / (S·E − 0.1P), M = ¼(3+√(L/r))</li>
            <li><strong>Hemispherical head</strong> (UG-32(f)): t = P·R / (2S·E − 0.2P)</li>
            <li>Then: t<sub>req</sub> = t<sub>design</sub> + CA → round up to standard plate → MAWP back-calculated on corroded t<sub>nom</sub> − CA</li>
          </ul>
          <p class="mt-3">
            <strong class="text-theme-primary">Why two shell formulas?</strong> Hoop stress is twice axial stress, but the
            longitudinal seam (E in the denominator) is usually the weaker link — so UG-27 checks both and you must
            satisfy each. With equal joint efficiencies the circumferential formula governs; with a poor longitudinal
            seam RT grade, the balance shifts.
          </p>
          <p class="mt-3">
            <strong class="text-theme-primary">External pressure?</strong> Not covered — buckling per UG-28 uses Part D
            Subpart 3 charts; see the FAQ. Min. formed thickness per UG-16(b) is 1/16 in (≈1.6 mm) excluding CA.
          </p>
        </div>
      </div>
    </section>

    <!-- Sourcing CTA -->
    <section class="mt-12 rounded-xl bg-ink-900 border border-theme p-8 text-center" aria-label="Source pressure vessels">
      <h2 class="text-2xl font-bold text-theme-primary mb-3">Need It Built? <span class="accent-text">Source from ASME U-Stamp Shops</span></h2>
      <p class="text-theme-secondary max-w-2xl mx-auto mb-6">
        Once your thickness is scoped, the next step is a fabricator with an ASME U-stamp, II-D material traceability and
        Authorized Inspector sign-off — plus NDT, PWHT and hydrotest documentation. Send your vessel or heat-exchanger
        spec and we route it to qualified shops in the Hebei/Cangzhou industrial belt: SA-516-70 shells, formed heads,
        tube bundles, and skidded packages.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/request-a-quote/" class="inline-flex items-center justify-center gap-2 accent-bg hover:opacity-90 rounded-xl px-8 py-3.5 text-sm font-bold shadow-lg transition" style="color: #07090c;">
          Request a Quote from ASME Shops →
        </a>
        <a href="/cangzhou-flange-manufacturers/" class="inline-flex items-center justify-center gap-2 rounded-xl border border-theme px-8 py-3.5 text-sm font-bold text-theme-primary hover:bg-theme-secondary transition">
          Hebei Manufacturing Cluster
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-12" aria-label="Frequently asked questions">
      <h2 class="mb-4 text-xl font-bold text-theme-primary">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group card open:shadow-md">
            <summary class="cursor-pointer list-none px-5 py-3.5 text-sm font-semibold text-theme-secondary marker:hidden group-open:accent-text">
              {f.q}
              <span class="float-right text-theme-muted transition group-open:rotate-45 group-open:accent-text">+</span>
            </summary>
            <p class="px-5 pb-4 text-sm leading-relaxed text-theme-secondary">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="mt-12 rounded-xl bg-ink-900 border border-theme p-6 text-theme-primary" aria-label="Related tools">
      <h2 class="mb-3 text-lg font-bold">Related Engineering Tools</h2>
      <div class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <a href="/pipe-weight-calculator/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Pipe Weight Calculator</a>
        <a href="/pipe-schedule-chart/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Pipe Schedule Chart</a>
        <a href="/flange-weight-calculator/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Flange Weight Calculator</a>
        <a href="/elbow-weight-calculator/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Elbow Weight Calculator</a>
        <a href="/tee-weight-calculator/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Tee Weight Calculator</a>
        <a href="/reducer-weight-calculator/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Reducer Weight Calculator</a>
        <a href="/cangzhou-flange-manufacturers/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Cangzhou Flange Manufacturers</a>
        <a href="/request-a-quote/" class="rounded-lg accent-bg p-3 font-semibold transition hover:opacity-90 text-ink-950">→ Request a Quote</a>
      </div>
    </section>

    <!-- Disclaimer -->
    <p class="mt-8 disclaimer rounded-lg p-4 text-xs leading-relaxed">
      <strong>Disclaimer:</strong> This calculator implements ASME VIII Div.1 UG-27/UG-32 formulas with publicly
      republished II-D allowable stress values (100–650°F) for preliminary sizing only. It does not replace design,
      review, and certification by a qualified pressure-vessel engineer and an Authorized Inspector; code-stamped
      (U-stamp) vessels require a responsible manufacturer, full weld documentation, NDT, and hydrotest per ASME
      VIII-1. Nozzles (UG-37), external pressure (UG-28), fatigue, MDMT impact exemption (UCS-66), wind/seismic and
      jurisdiction-specific requirements are not covered.
    </p>
  </div>
</Base>

<script>
  import { JOINT_EFFICIENCIES, TEMP_ROWS_C, TEMP_ROWS_F, VESSEL_MATERIALS } from '../data/vessel-materials';
  import { COMPONENT_LIST, computeVesselThickness, type VesselComponent } from '../lib/vessel-calculations';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const state = {
    component: 'shell' as VesselComponent,
    units: (localStorage.getItem('pvf_vessel_unit') === 'imperial' ? 'imperial' : 'metric') as 'metric' | 'imperial',
    dimMode: 'id' as 'id' | 'ir',
    p: 1.0, dim: 2000, temp: 100, mat: 'sa516-70', e: 1.0, ca: 1.5,
    crownL: 0, knuckleR: 0,
    stressUnit: 'mpa' as 'mpa' | 'ksi',
  };

  const fmt = (v: number, d = 2) =>
    v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });

  const compName = (id: VesselComponent) => COMPONENT_LIST.find((c) => c.id === id)?.name ?? id;

  function populateMaterials() {
    const sel = $('material') as HTMLSelectElement;
    sel.innerHTML = '';
    for (const m of VESSEL_MATERIALS) {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = `${m.name} — ${m.form}`;
      if (m.id === state.mat) opt.selected = true;
      sel.appendChild(opt);
    }
  }

  function populateE() {
    const sel = $('jeff') as HTMLSelectElement;
    sel.innerHTML = '';
    for (const j of JOINT_EFFICIENCIES) {
      const opt = document.createElement('option');
      opt.value = String(j.e);
      opt.textContent = `E = ${j.e.toFixed(2)} — ${j.name}`;
      if (j.e === state.e) opt.selected = true;
      sel.appendChild(opt);
    }
  }

  function setCompButtons() {
    document.querySelectorAll<HTMLButtonElement>('.comp-btn').forEach((b) => {
      const active = b.dataset.comp === state.component;
      b.classList.toggle('accent-border', active);
      b.classList.toggle('accent-light-bg', active);
      b.classList.toggle('accent-text', active);
      b.classList.toggle('border-theme', !active);
      b.classList.toggle('text-theme-secondary', !active);
      b.setAttribute('aria-pressed', String(active));
    });
    const c = COMPONENT_LIST.find((x) => x.id === state.component);
    $('compDesc').textContent = c ? c.desc : '';
    $('toriRow').classList.toggle('hidden', state.component !== 'torispherical');
    $('toriRow').classList.toggle('lg:grid', state.component === 'torispherical');
  }

  function setModeButtons() {
    const on = 'bg-ink-900 text-theme-primary';
    const off = 'bg-theme-card text-theme-secondary hover:bg-theme-tertiary';
    $('modeId').className = 'mode-btn flex-1 px-3 py-2 text-sm font-semibold transition ' + (state.dimMode === 'id' ? on : off);
    $('modeIr').className = 'mode-btn flex-1 px-3 py-2 text-sm font-semibold transition ' + (state.dimMode === 'ir' ? on : off);
    $('dimLabel').textContent = state.dimMode === 'id' ? 'Inside Diameter' : 'Inside Radius';
  }

  function setUnitButtons() {
    const on = 'bg-ink-900 text-theme-primary';
    const off = 'bg-theme-card text-theme-secondary hover:bg-theme-tertiary';
    $('unitMetric').className = 'unit-btn flex-1 px-3 py-2 text-sm font-semibold transition ' + (state.units === 'metric' ? on : off);
    $('unitImperial').className = 'unit-btn flex-1 px-3 py-2 text-sm font-semibold transition ' + (state.units === 'imperial' ? on : off);
    document.querySelectorAll('.dim-unit').forEach((el) => { el.textContent = state.units === 'metric' ? 'mm' : 'in'; });
    document.querySelectorAll('.p-unit').forEach((el) => { el.textContent = state.units === 'metric' ? 'MPa' : 'psi'; });
    $('tempUnit').textContent = state.units === 'metric' ? '°C' : '°F';
  }

  function setTabButtons() {
    const on = 'bg-ink-900 text-theme-primary';
    const off = 'bg-theme-card text-theme-secondary hover:bg-theme-tertiary';
    $('tabMpa').className = 'tab-btn px-3 py-1.5 text-xs font-semibold transition ' + (state.stressUnit === 'mpa' ? on : off);
    $('tabKsi').className = 'tab-btn px-3 py-1.5 text-xs font-semibold transition ' + (state.stressUnit === 'ksi' ? on : off);
    document.querySelectorAll<HTMLElement>('[data-mpa]').forEach((td) => {
      td.querySelector('.cell-val')!.textContent = state.stressUnit === 'mpa' ? td.dataset.mpa! : td.dataset.ksi!;
    });
  }

  function tempF(): number {
    return state.units === 'metric' ? state.temp * 9 / 5 + 32 : state.temp;
  }

  function render() {
    const tF = tempF();
    const r = computeVesselThickness({
      component: state.component,
      units: state.units,
      pressure: state.p,
      dimMode: state.dimMode,
      dimValue: state.dim,
      tempF: tF,
      materialId: state.mat,
      jointE: state.e,
      ca: state.ca,
      crownL: state.crownL > 0 ? state.crownL : undefined,
      knuckleR: state.knuckleR > 0 ? state.knuckleR : undefined,
    });

    const warnBox = $('warnBox');
    if (!r.valid) {
      $('tValue').textContent = '–';
      $('resultLine').textContent = r.error === 'over-temperature'
        ? `S is not tabulated above 650°F (343°C) — use the latest ASME II-D for creep-range values.`
        : 'Check inputs.';
      $('outTdesign').textContent = '–';
      $('outTca').textContent = '–';
      $('outNominal').textContent = '–';
      $('outMawp').textContent = '–';
      $('outS').textContent = '–';
      $('outUg16').textContent = '–';
      $('seamList').innerHTML = '';
      $('geomList').innerHTML = '';
      warnBox.classList.remove('hidden');
      warnBox.innerHTML = r.warnings.map((w) => `<p>⚠ ${w}</p>`).join('');
      return;
    }

    const inThk = r.tWithCaMm / 25.4;
    const showMm = state.units === 'metric';
    $('tValue').textContent = fmt(showMm ? r.tWithCaMm : inThk, r.tWithCaMm < 10 ? 3 : 2);
    $('tUnit').textContent = showMm ? 'mm' : 'in';
    $('resultLine').textContent = `${compName(r.component)} · ${r.material?.name ?? ''} · ${Math.round(tF)}°F (≈ ${Math.round((tF - 32) * 5 / 9)}°C)`;

    const conv = (mm: number) => showMm ? `${fmt(mm, mm < 10 ? 3 : 2)} mm` : `${fmt(mm / 25.4, mm / 25.4 < 1 ? 4 : 3)} in`;
    $('outTdesign').textContent = conv(r.tDesignMm);
    $('outTca').textContent = conv(r.tWithCaMm);
    $('outNominal').textContent = conv(r.nominalMm);
    $('outMawp').textContent = `${fmt(r.mawpMpa, 3)} MPa · ${fmt(r.mawpPsi, 1)} psi`;
    $('outS').textContent = `${fmt(r.sMpa, 1)} MPa (${fmt(r.sKsi, 1)} ksi)`;
    $('outUg16').textContent = r.ug16Ok ? 'PASS (≥ 1/16 in)' : 'FAIL — increase t';
    $('outUg16').classList.toggle('accent-text', r.ug16Ok);

    if (r.warnings.length) {
      warnBox.classList.remove('hidden');
      warnBox.innerHTML = r.warnings.map((w) => `<p>⚠ ${w}</p>`).join('');
    } else {
      warnBox.classList.add('hidden');
      warnBox.innerHTML = '';
    }

    // Seam detail
    const rows: [string, string][] = [];
    if (r.shell) {
      rows.push(['Circ. stress t (long. seam)', conv(r.shell.tCircMm)]);
      rows.push(['Axial stress t (circ. seam)', conv(r.shell.tLongMm)]);
      rows.push(['Governing direction', r.shell.governing === 'circ' ? 'Circumferential (long. seam)' : 'Axial (circ. seam)']);
    } else if (r.head) {
      if (r.component === 'ellipsoidal21') rows.push(['Equivalent crown L = 0.9D', conv(r.head.crownLMm!)]);
      if (r.component === 'torispherical') {
        rows.push(['Crown radius L', conv(r.head.crownLMm!)]);
        rows.push(['Knuckle radius r', conv(r.head.knuckleRMm!)]);
        rows.push(['Stress factor M', fmt(r.head.mFactor!, 3)]);
      }
      if (r.component === 'hemispherical') rows.push(['Sphere radius R', conv(r.head.crownLMm!)]);
    }
    rows.push(['Joint efficiency E', state.e.toFixed(2)]);
    rows.push(['Corrosion allowance', conv(state.units === 'metric' ? state.ca : state.ca * 25.4)]);
    $('seamList').innerHTML = rows
      .map(([k, v]) => `<div class="flex justify-between border-b border-theme py-1.5"><dt class="text-theme-muted">${k}</dt><dd class="font-semibold text-theme-secondary">${v}</dd></div>`)
      .join('');

    // Geometry
    const g: [string, string][] = [
      ['Component', compName(r.component)],
      [state.dimMode === 'id' ? 'Inside diameter' : 'Inside radius', showMm ? `${fmt(state.dim, 1)} mm` : `${fmt(state.dim, 2)} in`],
      ['Design pressure', showMm ? `${fmt(state.p, 3)} MPa` : `${fmt(state.p, 1)} psi`],
      ['Design temperature', `${Math.round(tF)}°F / ≈${Math.round((tF - 32) * 5 / 9)}°C`],
    ];
    $('geomList').innerHTML = g
      .map(([k, v]) => `<div class="flex justify-between border-b border-theme py-1.5"><dt class="text-theme-muted">${k}</dt><dd class="font-semibold text-theme-secondary">${v}</dd></div>`)
      .join('');
  }

  // Events
  document.querySelectorAll<HTMLButtonElement>('.comp-btn').forEach((b) =>
    b.addEventListener('click', () => { state.component = b.dataset.comp as VesselComponent; setCompButtons(); render(); })
  );
  $('modeId').addEventListener('click', () => { state.dimMode = 'id'; setModeButtons(); render(); });
  $('modeIr').addEventListener('click', () => { state.dimMode = 'ir'; setModeButtons(); render(); });
  $('dimVal').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); if (v > 0) { state.dim = v; render(); } });
  $('pressure').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); if (v > 0) { state.p = v; render(); } });
  $('temp').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); state.temp = v; render(); });
  $('ca').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); if (v >= 0) { state.ca = v; render(); } });
  $('crownL').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); state.crownL = v > 0 ? v : 0; render(); });
  $('knuckR').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); state.knuckleR = v > 0 ? v : 0; render(); });
  $('material').addEventListener('change', (e) => { state.mat = (e.target as HTMLSelectElement).value; render(); });
  $('jeff').addEventListener('change', (e) => { state.e = Number((e.target as HTMLSelectElement).value); render(); });
  $('tabMpa').addEventListener('click', () => { state.stressUnit = 'mpa'; setTabButtons(); });
  $('tabKsi').addEventListener('click', () => { state.stressUnit = 'ksi'; setTabButtons(); });

  function convertInputs(to: 'metric' | 'imperial') {
    if (to === state.units) return;
    if (to === 'imperial') {
      state.dim = state.dim / 25.4; state.ca = state.ca / 25.4;
      state.p = state.p / 0.006894757; state.temp = state.temp * 9 / 5 + 32;
      if (state.crownL > 0) state.crownL /= 25.4;
      if (state.knuckleR > 0) state.knuckleR /= 25.4;
    } else {
      state.dim = state.dim * 25.4; state.ca = state.ca * 25.4;
      state.p = state.p * 0.006894757; state.temp = (state.temp - 32) * 5 / 9;
      if (state.crownL > 0) state.crownL *= 25.4;
      if (state.knuckleR > 0) state.knuckleR *= 25.4;
    }
    state.units = to;
    localStorage.setItem('pvf_vessel_unit', to);
    ($('dimVal') as HTMLInputElement).value = String(Math.round(state.dim * 100) / 100);
    ($('ca') as HTMLInputElement).value = String(Math.round(state.ca * 100) / 100);
    ($('pressure') as HTMLInputElement).value = String(Math.round(state.p * 1000) / 1000);
    ($('temp') as HTMLInputElement).value = String(Math.round(state.temp * 10) / 10);
    if (state.crownL > 0) ($('crownL') as HTMLInputElement).value = String(Math.round(state.crownL * 100) / 100);
    if (state.knuckleR > 0) ($('knuckR') as HTMLInputElement).value = String(Math.round(state.knuckleR * 100) / 100);
  }
  $('unitMetric').addEventListener('click', () => { convertInputs('metric'); setUnitButtons(); render(); });
  $('unitImperial').addEventListener('click', () => { convertInputs('imperial'); setUnitButtons(); render(); });

  // Table row → load material
  document.querySelectorAll<HTMLTableRowElement>('tr[data-mat]').forEach((tr) =>
    tr.addEventListener('click', () => {
      state.mat = tr.dataset.mat!;
      ($('material') as HTMLSelectElement).value = state.mat;
      render();
      $('tool').scrollIntoView({ behavior: 'smooth', block: 'start' });
    })
  );

  // Copy Result
  $('copyBtn').addEventListener('click', () => {
    const t = ($('tValue') as HTMLElement).textContent ?? '–';
    const unit = ($('tUnit') as HTMLElement).textContent ?? '';
    const line = ($('resultLine') as HTMLElement).textContent ?? '';
    const nominal = ($('outNominal') as HTMLElement).textContent ?? '–';
    const mawp = ($('outMawp') as HTMLElement).textContent ?? '–';
    const s = ($('outS') as HTMLElement).textContent ?? '–';
    const text = `PVF Calculator — Pressure Vessel Thickness (ASME VIII-1)\n${line}\nRequired t incl. CA: ${t} ${unit} · Nominal: ${nominal} · MAWP: ${mawp}\nS = ${s}\nhttps://pvfcalculator.com/pressure-vessel-thickness-calculator/`;
    navigator.clipboard.writeText(text).then(() => {
      $('copyBtnLabel').textContent = '✓ Copied!';
      setTimeout(() => { $('copyBtnLabel').textContent = 'Copy Result'; }, 2000);
    });
  });

  // Share Link
  $('shareBtn').addEventListener('click', () => {
    const sp = new URLSearchParams({
      comp: state.component, units: state.units, mode: state.dimMode,
      dim: String(state.dim), p: String(state.p), temp: String(state.temp),
      mat: state.mat, e: String(state.e), ca: String(state.ca),
    });
    if (state.crownL > 0) sp.set('crownl', String(state.crownL));
    if (state.knuckleR > 0) sp.set('knuckler', String(state.knuckleR));
    history.replaceState(null, '', '?' + sp.toString());
    navigator.clipboard.writeText(location.href).then(() => {
      $('shareBtnLabel').textContent = '✓ Link copied!';
      setTimeout(() => { $('shareBtnLabel').textContent = 'Share Link'; }, 2000);
    });
  });

  // Restore from URL params on load
  {
    const sp = new URLSearchParams(location.search);
    let changed = false;
    const c = sp.get('comp') as VesselComponent;
    if (c && COMPONENT_LIST.some((x) => x.id === c)) { state.component = c; changed = true; }
    const u = sp.get('units');
    if (u === 'metric' || u === 'imperial') { state.units = u; changed = true; }
    const m = sp.get('mode');
    if (m === 'id' || m === 'ir') { state.dimMode = m; changed = true; }
    const dim = Number(sp.get('dim')); if (dim > 0) { state.dim = dim; changed = true; }
    const p = Number(sp.get('p')); if (p > 0) { state.p = p; changed = true; }
    const t = Number(sp.get('temp')); if (t > -100 && t < 2000) { state.temp = t; changed = true; }
    const mat = sp.get('mat');
    if (mat && VESSEL_MATERIALS.some((x) => x.id === mat)) { state.mat = mat; changed = true; }
    const e = Number(sp.get('e')); if (e > 0 && e <= 1) { state.e = e; changed = true; }
    const ca = Number(sp.get('ca')); if (ca >= 0) { state.ca = ca; changed = true; }
    const cl = Number(sp.get('crownl')); if (cl > 0) { state.crownL = cl; changed = true; }
    const kr = Number(sp.get('knuckler')); if (kr > 0) { state.knuckleR = kr; changed = true; }
    ($('dimVal') as HTMLInputElement).value = String(state.dim);
    ($('pressure') as HTMLInputElement).value = String(state.p);
    ($('temp') as HTMLInputElement).value = String(state.temp);
    ($('ca') as HTMLInputElement).value = String(state.ca);
  }

  // Init
  populateMaterials();
  populateE();
  setCompButtons();
  setModeButtons();
  setUnitButtons();
  setTabButtons();
  render();
</script>
