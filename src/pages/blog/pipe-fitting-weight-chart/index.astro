            <span>Calculate exact reducer weight by size and material</span>
          </a>
          <a href="/pipe-schedule-chart/" class="related-card">
            <strong>Pipe Schedule Chart</strong>
            <span>Wall thickness for all schedules and sizes</span>
          </a>
        </div>
      </section>
    </div>
  </article>
</Base>
