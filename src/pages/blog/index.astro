---
import Base from "../../layouts/Base.astro";

const title = "PVF Technical Blog: Pipe Fittings, Flanges & ASME Standards";
const description =
  "Technical guides and reference articles on pipe fittings, flanges, ASME standards, and material selection for industrial piping applications.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  headline: "PVF Calculator Blog",
  description,
  author: { "@type": "Organization", name: "PVF Calculator" },
  publisher: { "@type": "Organization", name: "PVF Calculator" },
};

const posts = [
  {
    slug: "/blog/flange-bolt-torque-chart-pcc-1/",
    title: "Flange Bolt Torque Chart (PCC-1): Values, K Factor & Three-Pass Method",
    description:
      "Flange bolt torque chart per ASME PCC-1: recommended torque values by flange size and class, how the K factor affects torque, and the three-pass bolting sequence.",
    date: "July 31, 2026",
    readTime: "9 min",
    category: "Technical Guide",
  },
  {
    slug: "/blog/why-bolt-torque-calculators-disagree/",
    title: "Why Bolt Torque Calculators Disagree by 30% (and How to Check Them)",
    description:
      "Two bolt torque calculators can give results 30% apart and both claim to follow ASME PCC-1. Here's what actually drives the difference — K factor, friction, and lubrication.",
    date: "July 31, 2026",
    readTime: "7 min",
    category: "Industry Insight",
  },
  {
    slug: "/blog/how-to-calculate-valve-cv/",
    title: "How to Calculate Valve Cv: Liquid, Gas & Steam Sizing Worked Examples",
    description:
      "Step-by-step valve Cv calculation for liquids, gases, and steam, with worked examples. Learn the Cv formula, unit conversions, and how to pick the right valve size.",
    date: "July 31, 2026",
    readTime: "8 min",
    category: "Technical Guide",
  },
  {
    slug: "/blog/valve-weight-chart-by-class/",
    title: "Valve Weight Chart by Class: Gate, Globe, Check & Ball (Class 150/300/600)",
    description:
      "Valve weight chart by pressure class for gate, globe, check, and ball valves. Typical weights from NPS 2 to 12 in Class 150, 300, and 600 for freight estimating.",
    date: "July 31, 2026",
    readTime: "7 min",
    category: "Technical Guide",
  },
  {
    slug: "/blog/gate-vs-globe-vs-ball-vs-check-valve/",
    title: "Gate vs Globe vs Ball vs Check Valve: How to Choose (2026 Selection Guide)",
    description:
      "Gate, globe, ball, and check valves compared: working principle, pressure drop, sealing, cost, and typical applications. A practical selection guide for piping engineers.",
    date: "July 31, 2026",
    readTime: "9 min",
    category: "Technical Guide",
  },
  {
    slug: "/blog/asme-viii-ug-27-thickness-explained/",
    title: "ASME VIII UG-27 & UG-32 Thickness, Explained With a Full Worked Example",
    description:
      "ASME VIII Div 1 UG-27 and UG-32 wall thickness formulas explained in plain language, with a complete worked example for a pressure vessel shell and 2:1 ellipsoidal head.",
    date: "July 31, 2026",
    readTime: "10 min",
    category: "Technical Guide",
  },
  {
    slug: "/blog/mengcun-vs-yanshan-sourcing/",
    title: "Mengcun vs Yanshan: Which Hebei Cluster Should You Source Pipe Fittings From?",
    description:
      "Mengcun and Yanshan both ship ASME B16.9 fittings worldwide, but they specialize differently. Compare product range, pricing, MOQ, and export experience before you buy.",
    date: "July 31, 2026",
    readTime: "8 min",
    category: "Sourcing Guide",
  },
  {
    slug: "/blog/mss-sp-75-vs-asme-b16-9/",
    title: "MSS SP-75 vs ASME B16.9: High-Yield Fitting Standards Compared",
    description:
      "MSS SP-75 vs ASME B16.9: key differences in size range, material grades, pressure ratings, and applications. Learn when to specify WPHY fittings over standard B16.9.",
    date: "September 13, 2026",
    readTime: "8 min",
    category: "Standards",
  },
  {
    slug: "/blog/flange-facing-types/",
    title: "Flange Facing Types: RF, FF, RTJ, M&F, T&G Selection Guide",
    description:
      "Flange facing types explained: raised face (RF), flat face (FF), ring type joint (RTJ), male & female, tongue & groove. Learn which facing to use for your pressure class and gasket type.",
    date: "September 10, 2026",
    readTime: "9 min",
    category: "Flange Design",
  },
  {
    slug: "/blog/piping-class-chart/",
    title: "Piping Class Chart: 150#–1500# Materials, Fittings, Gaskets",
    description:
      "Piping class chart for Class 150, 300, 600, 900, 1500. Standard materials, fitting specs, gasket types, flange facings, and pipe schedules for each class.",
    date: "September 6, 2026",
    readTime: "10 min",
    category: "Engineering Reference",
  },
  {
    slug: "/blog/pipe-schedule-chart-explained/",
    title: "Pipe Schedule Chart Explained: Complete Guide to SCH 10–XXS",
    description:
      "Learn what pipe schedule numbers mean, how to read a pipe schedule chart, and the difference between SCH 10, 40, 80, 160, and XXS wall thicknesses.",
    date: "September 2, 2026",
    readTime: "8 min",
    category: "Pipe Basics",
  },
  {
    slug: "/blog/flange-weight-chart-errors/",
    title: "We Checked 3 Popular Online Flange Weight Charts. 9 Values Were Wrong by 10x.",
    description:
      "We audited 3 widely used online flange weight charts against ASME B16.5 geometric calculations. 9 of the published values were off by a factor of 10 or more.",
    date: "August 25, 2026",
    readTime: "9 min",
    category: "Accuracy",
  },
  {
    slug: "/blog/asme-b16-5-vs-b16-47/",
    title: "ASME B16.5 vs B16.47: Flange Standard Comparison",
    description:
      "Compare ASME B16.5 and B16.47 flange standards. Learn the differences in size range, pressure classes, applications, and how to choose the right standard for your project.",
    date: "August 21, 2026",
    readTime: "7 min",
    category: "Flange Standards",
  },
  {
    slug: "/blog/304-vs-316-stainless-steel-flanges/",
    title: "304 vs 316 Stainless Steel Flanges: Which One Do You Need?",
    description:
      "Compare 304 and 316 stainless steel flanges for corrosion resistance, temperature limits, cost, and applications. Learn when to upgrade from 304 to 316 in coastal, chemical, and high-chloride environments.",
    date: "August 17, 2026",
    readTime: "8 min",
    category: "Materials",
  },
  {
    slug: "/blog/how-to-choose-flange-class/",
    title: "How to Choose the Right Flange Class (150–2500)",
    description:
      "Learn how to select the correct ASME flange pressure class for your application. Compare Class 150, 300, 600, 900, 1500, and 2500 ratings with temperature-pressure tables and selection guidelines.",
    date: "August 13, 2026",
    readTime: "9 min",
    category: "Flange Selection",
  },
  {
    slug: "/blog/pipe-fitting-weight-calculator-comparison/",
    title: "Pipe Fitting Weight Calculator Comparison: We Tested 5 Tools",
    description:
      "We tested 5 popular pipe fitting weight calculators against ASME B16.9 reference values. Here's what we found — including 10x errors, missing inputs, and what an accurate calculator actually requires.",
    date: "August 11, 2026",
    readTime: "10 min",
    category: "Accuracy",
  },
  {
    slug: "/blog/astm-a105-vs-a234-wpb/",
    title: "ASTM A105 vs A234 WPB: Forged Flange vs Wrought Fitting",
    description:
      "ASTM A105 and A234 WPB are the most common carbon steel materials in piping. Learn the differences in manufacturing process, mechanical properties, applications, and why they are not interchangeable.",
    date: "August 7, 2026",
    readTime: "8 min",
    category: "Materials",
  },
  {
    slug: "/blog/weld-neck-vs-slip-on-flange/",
    title: "Weld Neck vs Slip-On vs Socket Weld vs Threaded: Flange Type Selection Guide",
    description:
      "Compare weld neck, slip-on, socket weld, threaded, and lap joint flanges. Learn which flange type to use for high pressure, high temperature, corrosive media, and cost-sensitive applications.",
    date: "August 3, 2026",
    readTime: "10 min",
    category: "Flange Design",
  },
  {
    slug: "/blog/pipe-fitting-weight-chart/",
    title: "Pipe Fitting Weight Chart: NPS 1/2\" to 24\" (kg per piece)",
    description:
      "Complete pipe fitting weight chart for elbows, tees, reducers, and caps. NPS 1/2\" to 24\", Sch 40 and Sch 80, carbon steel and stainless steel. Use for estimating, shipping, and procurement.",
    date: "July 30, 2026",
    readTime: "8 min",
    category: "Engineering Reference",
  },
  {
    slug: "/blog/why-flange-calculators-are-wrong/",
    title: "Why Most Online Flange Weight Calculators Give Wrong Results",
    description:
      "Most flange weight calculators online are wrong — sometimes by 10x or more. Here's why, and how ASME B16.5 geometric modeling fixes it.",
    date: "July 28, 2026",
    readTime: "8 min",
    category: "Accuracy",
  },
];
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog/" },
];
---

<Base title={title} description={description} jsonLd={jsonLd} breadcrumbItems={breadcrumbItems} ctaHref="/request-a-quote/">
  <section class="relative overflow-hidden py-20 px-4">
    <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 via-transparent to-transparent pointer-events-none"></div>
    <div class="max-w-4xl mx-auto relative z-10 text-center">
      <h1 class="text-3xl md:text-5xl font-bold mb-4 text-theme-primary">
        PVF <span class="accent-text">Blog</span>
      </h1>
      <p class="text-lg text-theme-secondary max-w-2xl mx-auto">
        Technical guides on pipe fittings, flanges, ASME standards, and material selection for industrial piping professionals.
      </p>
    </div>
  </section>

  <section class="py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="space-y-6">
        {posts.map((post) => (
          <a href={post.slug} class="glass rounded-2xl p-6 md:p-8 block group hover:border-theme transition-colors">
            <div class="flex flex-col md:flex-row md:items-center gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-xs font-medium px-3 py-1 rounded-full accent-bg" style="color: #07090c;">
                    {post.category}
                  </span>
                  <span class="text-xs text-theme-muted">{post.date}</span>
                  <span class="text-xs text-theme-muted">·</span>
                  <span class="text-xs text-theme-muted">{post.readTime} read</span>
                </div>
                <h2 class="text-xl md:text-2xl font-bold text-theme-primary mb-2 group-hover:text-theme-primary transition-colors">
                  {post.title}
                </h2>
                <p class="text-theme-secondary text-sm leading-relaxed">
                  {post.description}
                </p>
              </div>
              <div class="shrink-0">
                <div class="w-10 h-10 rounded-full border border-theme flex items-center justify-center group-hover:bg-theme-tertiary transition-colors">
                  <svg class="w-5 h-5 text-theme-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="/request-a-quote/"
          class="inline-block accent-bg hover:opacity-90 font-semibold px-8 py-3 rounded-xl transition-colors"
          style="color: #07090c;"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </section>
</Base>
