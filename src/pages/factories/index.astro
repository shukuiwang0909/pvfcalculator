---
import Base from "../../layouts/Base.astro";
import factoriesJson from "../../data/factories.json";

interface Factory {
  slug: string;
  name: string;
  nameZh?: string;
  tier: "listed" | "verified";
  products: string[];
  standards: string[];
  materials: string[];
  city: string;
  province: string;
  website?: string;
  description: string;
  founded?: number;
  certifications?: string[];
  exportMarkets?: string[];
}

const factories = factoriesJson as unknown as Factory[];

const title = "Mengcun Pipe Fitting Manufacturers Directory | PVF Calculator";
const description =
  "Directory of pipe fitting and flange manufacturers in Mengcun and Cangzhou, Hebei. Each listing includes product range, standards coverage (ASME B16.5/B16.9, DIN, JIS), materials, and certifications.";
const canonical = "https://pvfcalculator.com/factories/";

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Factories", url: "/factories/" },
];

const productFilters = ["Flanges", "Elbows", "Tees", "Reducers", "Stainless Steel Fittings"];
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbItems={breadcrumbItems}
>
  <div class="max-w-6xl mx-auto px-4 py-10 sm:py-16">

    <!-- Header -->
    <div class="mb-10">
      <nav class="text-sm text-gray-500 mb-6 flex items-center gap-1">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span class="mx-1">›</span>
        <span class="text-gray-300">Factories</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Mengcun Pipe Fitting Manufacturers</h1>
      <p class="text-gray-400 max-w-2xl leading-relaxed">
        {factories.length} manufacturers in Mengcun and Cangzhou, Hebei — China's main production cluster for ASME B16.9
        buttweld fittings and B16.5 flanges. All listings are free; we never sell ranking positions.
      </p>
    </div>

    <!-- Claim banner -->
    <div class="bg-gray-900 border border-amber-400/30 rounded-xl p-5 mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <p class="font-semibold text-white mb-1">Are you a Mengcun or Cangzhou manufacturer?</p>
        <p class="text-sm text-gray-400">Free listing — get your products in front of engineers searching for quotes.</p>
      </div>
      <a href="/request-a-quote/" class="shrink-0 inline-block px-5 py-2.5 bg-amber-400 hover:bg-amber-300 text-black text-sm font-semibold rounded-lg transition-colors">
        List Your Factory →
      </a>
    </div>

    <!-- Factory grid -->
    <div class="grid md:grid-cols-2 gap-5">
      {factories.map((factory) => (
        <a
          href={`/factories/${factory.slug}/`}
          class="group block bg-gray-900 border border-gray-800 hover:border-amber-400/40 rounded-xl p-6 transition-colors"
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <h2 class="font-semibold text-white group-hover:text-amber-400 transition-colors leading-tight">{factory.name}</h2>
              {factory.nameZh && <p class="text-gray-500 text-sm mt-0.5">{factory.nameZh}</p>}
            </div>
            <span class="shrink-0 text-xs px-2 py-0.5 rounded-full border border-gray-700 text-gray-500 mt-0.5">
              Free Listing
            </span>
          </div>

          <p class="text-gray-400 text-sm leading-relaxed mb-4 line-clamp-2">{factory.description}</p>

          <div class="flex flex-wrap gap-1.5 mb-3">
            {factory.products.slice(0, 4).map((p) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-gray-800 border border-gray-700 text-gray-400">{p}</span>
            ))}
          </div>

          <div class="flex items-center justify-between text-xs text-gray-600">
            <span>{factory.city}, {factory.province}</span>
            {factory.founded && <span>Est. {factory.founded}</span>}
          </div>
        </a>
      ))}
    </div>

    <!-- Calculator cross-link -->
    <div class="mt-12 bg-gray-900 border border-gray-800 rounded-xl p-6">
      <p class="font-semibold text-white mb-1">Calculate before you order</p>
      <p class="text-gray-400 text-sm mb-4">Use our free weight calculators to verify shipping weights and build your bill of materials.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/flange-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Flange Weight Calculator →</a>
        <a href="/elbow-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Elbow Weight Calculator →</a>
        <a href="/tee-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Tee Weight Calculator →</a>
        <a href="/reducer-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Reducer Weight Calculator →</a>
        <a href="/pipe-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Pipe Weight Calculator →</a>
      </div>
    </div>

    <p class="mt-8 text-xs text-gray-600">
      PVFCalculator lists manufacturers for reference only. Verify suppliers independently before payment.
      See <a href="/mengcun-pipe-fittings/" class="underline hover:text-gray-400">Mengcun sourcing guide</a> for audit and quality-check guidance.
    </p>

  </div>
</Base>
