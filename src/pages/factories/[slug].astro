---
import Base from "../../layouts/Base.astro";
import factoriesJson from "../../data/factories.json";

interface Factory {
  slug: string;
  name: string;
  nameZh?: string;
  tier: "listed" | "verified";
  products: string[];
  standards: string[];
  materials: string[];
  city: string;
  province: string;
  website?: string;
  description: string;
  founded?: number;
  certifications?: string[];
  exportMarkets?: string[];
  contact?: { email?: string; phone?: string; whatsapp?: string };
  verifiedNote?: string;
}

export function getStaticPaths() {
  const data = factoriesJson as unknown as Factory[];
  return data.map((factory) => ({
    params: { slug: factory.slug },
    props: { factory },
  }));
}

const { factory } = Astro.props as { factory: Factory };
const origin = "https://pvfcalculator.com";
const canonical = `${origin}/factories/${factory.slug}/`;

const infoRows: [string, string][] = [
  ["Location", `${factory.city}, ${factory.province}, China`],
  ...(factory.founded ? [["Founded", String(factory.founded)] as [string, string]] : []),
  ...(factory.standards?.length ? [["Standards", factory.standards.join(", ")] as [string, string]] : []),
  ...(factory.materials?.length ? [["Materials", factory.materials.join(", ")] as [string, string]] : []),
  ...(factory.exportMarkets?.length ? [["Export markets", factory.exportMarkets.join(", ")] as [string, string]] : []),
  ...(factory.certifications?.length ? [["Certifications", factory.certifications.join(", ")] as [string, string]] : []),
];

const orgJson = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: factory.name,
  url: canonical,
  ...(factory.website ? { sameAs: factory.website } : {}),
  description: factory.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: factory.city,
    addressRegion: factory.province,
    addressCountry: "CN",
  },
  ...(factory.founded ? { foundingDate: String(factory.founded) } : {}),
};

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Factories", url: "/factories/" },
  { name: factory.name, url: canonical },
];
---

<Base
  title={`${factory.name} — Mengcun Pipe Fitting Manufacturer`}
  description={factory.description}
  canonical={canonical}
  breadcrumbItems={breadcrumbItems}
  jsonLd={orgJson}
>
  <div class="max-w-4xl mx-auto px-4 py-10 sm:py-16">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-8 flex flex-wrap items-center gap-1">
      <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
      <span class="mx-1">›</span>
      <a href="/factories/" class="hover:text-amber-400 transition-colors">Factories</a>
      <span class="mx-1">›</span>
      <span class="text-gray-300 truncate">{factory.name}</span>
    </nav>

    <!-- Header -->
    <div class="mb-6">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <h1 class="text-3xl md:text-4xl font-bold text-white">{factory.name}</h1>
        {factory.tier === "verified" && (
          <span class="shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-400 text-black">Verified ✓</span>
        )}
        {factory.tier === "listed" && (
          <span class="shrink-0 text-xs font-medium px-2.5 py-1 rounded-full border border-gray-600 text-gray-400">Free Listing</span>
        )}
      </div>
      {factory.nameZh && <p class="text-gray-400 text-lg">{factory.nameZh}</p>}
    </div>

    <p class="text-gray-300 text-lg leading-relaxed mb-8">{factory.description}</p>

    <!-- Product tags -->
    {factory.products?.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {factory.products.map((p) => (
          <span class="text-xs px-3 py-1 rounded-full bg-gray-800 border border-gray-700 text-gray-300">{p}</span>
        ))}
      </div>
    )}

    <!-- Info table -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-6">
      <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
        {infoRows.map(([k, v]) => (
          <div class="flex justify-between gap-4 border-b border-gray-800 pb-2">
            <dt class="text-gray-500 shrink-0">{k}</dt>
            <dd class="text-gray-200 text-right">{v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Contact block (verified only) -->
    {factory.tier === "verified" && factory.contact && (
      <div class="bg-gray-900 border border-amber-400/40 rounded-xl p-6 mb-6">
        <p class="font-semibold text-white mb-1">Verified contact <span class="text-amber-400">✓</span></p>
        {factory.verifiedNote && <p class="text-xs text-gray-500 mb-4">{factory.verifiedNote}</p>}
        <ul class="space-y-2 text-sm">
          {factory.contact.email && (
            <li class="flex justify-between gap-4">
              <span class="text-gray-500">Email</span>
              <a href={`mailto:${factory.contact.email}`} class="text-amber-400 underline hover:text-amber-300">{factory.contact.email}</a>
            </li>
          )}
          {factory.contact.phone && (
            <li class="flex justify-between gap-4">
              <span class="text-gray-500">Phone</span>
              <a href={`tel:${factory.contact.phone.replace(/\s/g, "")}`} class="text-gray-200">{factory.contact.phone}</a>
            </li>
          )}
          {factory.contact.whatsapp && (
            <li class="flex justify-between gap-4">
              <span class="text-gray-500">WhatsApp</span>
              <a href={`https://wa.me/${factory.contact.whatsapp.replace(/[^\d]/g, "")}`} class="text-amber-400 underline">{factory.contact.whatsapp}</a>
            </li>
          )}
        </ul>
      </div>
    )}

    <!-- Listed notice -->
    {factory.tier === "listed" && (
      <p class="text-sm text-gray-500 bg-gray-900 border border-gray-800 rounded-lg p-4 mb-6">
        This is a <strong class="text-gray-300">free listed</strong> profile — contact details are not published here.
        Use the inquiry form below; your message goes directly to this factory.
      </p>
    )}

    <!-- CTA -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-8 text-center mb-8">
      <p class="text-2xl font-bold text-white mb-3">Contact {factory.name}</p>
      <p class="text-gray-400 mb-6 max-w-xl mx-auto">
        Send your specification once — pipe schedule, fitting type, quantity and delivery port —
        and receive a firm FOB quote within 24 hours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`/request-a-quote/?factory=${factory.slug}`}
          class="inline-block px-8 py-3 bg-amber-400 hover:bg-amber-300 text-black font-semibold rounded-lg transition-colors"
        >
          Request a Quote
        </a>
        {factory.website && (
          <a
            href={factory.website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-3 bg-transparent border border-gray-700 text-gray-200 font-semibold rounded-lg hover:border-gray-500 transition-colors"
          >
            Visit Official Website ↗
          </a>
        )}
      </div>
    </div>

    <!-- Calculator cross-link -->
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-5 mb-8">
      <p class="text-sm text-gray-400 mb-3">Calculate weights before you order:</p>
      <div class="flex flex-wrap gap-3 text-sm">
        <a href="/flange-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Flange Weight Calculator →</a>
        <a href="/elbow-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Elbow Weight Calculator →</a>
        <a href="/tee-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Tee Weight Calculator →</a>
        <a href="/reducer-weight-calculator/" class="text-amber-400 hover:text-amber-300 transition-colors">Reducer Weight Calculator →</a>
      </div>
    </div>

    <p class="text-xs text-gray-600">
      PVFCalculator lists manufacturers for reference only and does not certify products or guarantee transactions.
      Verify all suppliers independently before payment — request MTRs, check certifications, and consider a third-party inspection.
    </p>

  </div>
</Base>
