            <div class="glass rounded-2xl p-5">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl accent-bg" style="color: #07090c;">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999A5.002 5.002 0 103.1 15H3z" />
                </svg>
              </div>
