---
const title = "PVF Calculator - Pipe Fitting Weight Calculators | ASME B16.5 & B16.9";
const description = "Free ASME B16.5 & B16.9 weight calculators for pipe fittings. Calculate flange, elbow, tee, and reducer weights in carbon steel, stainless steel, and alloy steel.";
const canonical = "https://pvfcalculator.com/";

const tools = [
  {
    name: "Flange Weight Calculator",
    short: "Flange",
    desc: "Weld neck, slip on, blind, socket weld & threaded flanges",
    specs: "Class 150-2500 · NPS 1/2\"-24\" · 5 Types",
    href: "/flange-weight-calculator/",
    icon: "M12 2L2 7v10c0 5.25 3.75 10.15 8 11 4.25-.85 8-5.75 8-11V7l-10-5zm0 2.18l8 4.02V17c0 4.52-3.275 8.7-7 9.55-3.725-.85-7-5.03-7-9.55V8.2l8-4.02zM12 6a4 4 0 100 8 4 4 0 000-8zm0 2a2 2 0 110 4 2 2 0 010-4z",
    color: "from-blue-500 to-blue-600",
    bgColor: "bg-blue-50",
    borderColor: "border-blue-200",
    hoverBorder: "hover:border-blue-400"
  },
  {
    name: "Elbow Weight Calculator", 
    short: "Elbow",
    desc: "45° & 90° long radius and short radius elbows",
    specs: "LR / SR · 13 Schedules · SCH 10-XXS",
    href: "/elbow-weight-calculator/",
    icon: "M20 6v8a4 4 0 01-4 4H8a4 4 0 01-4-4v-2a4 4 0 014-4h8a4 4 0 004-4zm0 0V4m0 2h-4",
    color: "from-emerald-500 to-emerald-600",
    bgColor: "bg-emerald-50",
    borderColor: "border-emerald-200",
    hoverBorder: "hover:border-emerald-400"
  },
  {
    name: "Tee Weight Calculator",
    desc: "Equal & reducing tees with smart branch validation", 
    specs: "Equal / Reducing · Auto-validation · B16.9",
    href: "/tee-weight-calculator/",
    icon: "M12 2v8m0 0l4-4m-4 4L8 6M4 14a4 4 0 004 4h8a4 4 0 004-4v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2z",
    color: "from-violet-500 to-violet-600",
    bgColor: "bg-violet-50", 
    borderColor: "border-violet-200",
    hoverBorder: "hover:border-violet-400"
  },
  {
    name: "Reducer Weight Calculator",
    desc: "Concentric & eccentric butt-weld reducers",
    specs: "CON / ECC · Smart pairing · 20+ Combos",
    href: "/reducer-weight-calculator/",
    icon: "M4 8h16l-4 8H8L4 8zm0 0v8m16-8v8M8 16v2m8-2v2",
    color: "from-amber-500 to-orange-600",
    bgColor: "bg-amber-50",
    borderColor: "border-amber-200", 
    hoverBorder: "hover:border-amber-400"
  }
];

const features = [
  { title: "ASME B16.5", desc: "Flange dimensions per latest standard" },
  { title: "ASME B16.9", desc: "Butt-weld fitting weights" },
  { title: "13 Schedules", desc: "SCH 10, 20, 30, STD, 40, 60, XS, 80, 100, 120, 140, 160, XXS" },
  { title: "5 Materials", desc: "A105, F304, F316, F11 + custom density" },
  { title: "kg / lb", desc: "Instant unit switching" },
  { title: "Mobile First", desc: "Works on any device" }
];

const stats = [
  { value: "4", label: "Calculators" },
  { value: "50+", label: "Flange Types" },
  { value: "13", label: "Schedules" },
  { value: "100%", label: "Free" }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "PVF Calculator",
  "url": canonical,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": canonical + "?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="pvfcalculator.com" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
  <!-- Header -->
  <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-50">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
      <a href="/" class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-orange-400 to-orange-600">
          <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
        <span class="text-xl font-bold tracking-tight">pvf<span class="text-orange-400">calculator</span>.com</span>
      </a>
      <nav class="hidden gap-6 text-sm font-medium text-slate-300 sm:flex">
        <a href="/flange-weight-calculator/" class="transition hover:text-white">Flange</a>
        <a href="/elbow-weight-calculator/" class="transition hover:text-white">Elbow</a>
        <a href="/tee-weight-calculator/" class="transition hover:text-white">Tee</a>
        <a href="/reducer-weight-calculator/" class="transition hover:text-white">Reducer</a>
      </nav>
      <a href="#tools" class="rounded-lg bg-orange-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-orange-600">
        Calculate Now
      </a>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4">
    <!-- Hero -->
    <section class="py-12 sm:py-16">
      <div class="text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-orange-100 px-4 py-1.5 text-sm font-medium text-orange-700">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-orange-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-orange-500"></span>
          </span>
          Free Engineering Tools — No Signup Required
        </div>
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Pipe Fitting <span class="bg-gradient-to-r from-orange-500 to-orange-600 bg-clip-text text-transparent">Weight Calculators</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600">
          Professional ASME B16.5 & B16.9 calculators for procurement engineers, 
          freight forwarders, and project managers. Trusted by industry professionals worldwide.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="#tools" class="w-full rounded-xl bg-slate-900 px-8 py-3.5 text-sm font-semibold text-white shadow-lg transition hover:bg-slate-800 sm:w-auto">
            Start Calculating
          </a>
          <a href="/flange-weight-calculator/" class="w-full rounded-xl border-2 border-slate-200 bg-white px-8 py-3.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 sm:w-auto">
            Try Flange Calculator →
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {stats.map((stat) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm">
            <div class="text-3xl font-extrabold text-slate-900">{stat.value}</div>
            <div class="mt-1 text-sm font-medium text-slate-500">{stat.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Tools Grid -->
    <section id="tools" class="scroll-mt-24 pb-12">
      <div class="mb-6 text-center">
        <h2 class="text-2xl font-bold text-slate-900">Choose Your Calculator</h2>
        <p class="mt-2 text-slate-600">Select a tool to calculate theoretical weights instantly</p>
      </div>
      
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {tools.map((tool) => (
          <a 
            href={tool.href}
            class={`group relative overflow-hidden rounded-2xl border-2 ${tool.borderColor} ${tool.hoverBorder} ${tool.bgColor} p-6 transition-all duration-200 hover:shadow-lg`}
          >
            <div class="flex items-start justify-between">
              <div class={`flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br ${tool.color} text-white shadow-md`}>
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={tool.icon} />
                </svg>
              </div>
              <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-wider text-slate-600 shadow-sm">
                {tool.short}
              </span>
            </div>
            
            <h3 class="mt-4 text-xl font-bold text-slate-900">{tool.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{tool.desc}</p>
            
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tool.specs.split('·').map((spec) => (
                <span class="rounded-md bg-white/80 px-2 py-1 text-xs font-medium text-slate-600">
                  {spec.trim()}
                </span>
              ))}
            </div>
            
            <div class="mt-5 flex items-center gap-2 text-sm font-semibold text-slate-900 opacity-0 transition-all duration-200 group-hover:opacity-100">
              Open Calculator 
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Features -->
    <section class="pb-12">
      <div class="rounded-3xl bg-slate-900 p-8 text-white sm:p-10">
        <div class="text-center">
          <h2 class="text-2xl font-bold">Built for Engineering Professionals</h2>
          <p class="mt-2 text-slate-400">Standards-compliant calculations you can trust</p>
        </div>
        
        <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
          {features.map((f) => (
            <div class="text-center">
              <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-800 text-orange-400">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <p class="text-sm font-bold">{f.title}</p>
              <p class="mt-1 text-xs text-slate-400">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section class="grid gap-6 pb-12 lg:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-3 flex items-center gap-2">
          <div class="h-8 w-1 rounded-full bg-blue-500"></div>
          <h2 class="text-lg font-bold text-slate-900">ASME B16.5 Flange Weights</h2>
        </div>
        <p class="text-sm leading-relaxed text-slate-600">
          Calculate theoretical weights for weld neck (WN), slip on (SO), blind (BL), socket weld (SW) and threaded (THD) 
          flanges per ASME B16.5. Supports Class 150, 300, 600, 900, 1500 and 2500 pressure ratings in NPS 1/2" through 24". 
          Includes A105 carbon steel, F304/F316 stainless steel, and F11 alloy steel with custom density input.
        </p>
        <a href="/flange-weight-calculator/" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:underline">
          Calculate flange weight
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-3 flex items-center gap-2">
          <div class="h-8 w-1 rounded-full bg-emerald-500"></div>
          <h2 class="text-lg font-bold text-slate-900">ASME B16.9 Fitting Weights</h2>
        </div>
        <p class="text-sm leading-relaxed text-slate-600">
          Butt-weld fitting weight calculators for 45°/90° elbows (long & short radius), equal/reducing tees, and 
          concentric/eccentric reducers. Covers SCH 10, 20, 30, STD, 40, 60, XS, 80, 100, 120, 140, 160 and XXS schedules 
          with automatic geometry validation.
        </p>
        <a href="/elbow-weight-calculator/" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 hover:underline">
          Calculate fitting weight
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="pb-12">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-orange-500 to-orange-600 p-8 text-center text-white sm:p-10">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.1%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-20"></div>
        <div class="relative">
          <h2 class="text-2xl font-bold sm:text-3xl">Need Factory Quotes from Cangzhou?</h2>
          <p class="mx-auto mt-3 max-w-xl text-orange-100">
            Connect with Hebei pipe fitting manufacturers for competitive pricing. 
            Free quotes within 24 hours from verified suppliers.
          </p>
          <a 
            href="mailto:quotes@pvfcalculator.com" 
            class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-8 py-3.5 text-sm font-bold text-orange-600 shadow-lg transition hover:bg-orange-50"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Request Factory Quote
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <div class="flex items-center gap-2">
          <div class="flex h-6 w-6 items-center justify-center rounded bg-gradient-to-br from-orange-400 to-orange-600">
            <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-slate-900">pvfcalculator.com</span>
        </div>
        <nav class="flex gap-6 text-sm text-slate-500">
          <a href="/flange-weight-calculator/" class="hover:text-slate-700">Flange</a>
          <a href="/elbow-weight-calculator/" class="hover:text-slate-700">Elbow</a>
          <a href="/tee-weight-calculator/" class="hover:text-slate-700">Tee</a>
          <a href="/reducer-weight-calculator/" class="hover:text-slate-700">Reducer</a>
        </nav>
      </div>
      <div class="mt-6 border-t border-slate-100 pt-6 text-center">
        <p class="text-xs text-slate-400">
          © 2026 PVF Calculator. Calculations based on ASME B16.5 & B16.9 standards. 
          Verify critical weights with manufacturers.
        </p>
      </div>
    </div>
  </footer>
</body>
</html>