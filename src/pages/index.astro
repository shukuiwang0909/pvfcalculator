---
import Base from "../layouts/Base.astro";

const title = "PVF Calculator - Pipe Fitting Weight Calculators | ASME B16.5 & B16.9";
const description = "Free ASME B16.5 & B16.9 weight calculators for pipe fittings. Calculate flange, elbow, tee, and reducer weights in carbon steel, stainless steel, and alloy steel.";
const canonical = "https://pvfcalculator.com/";

const tools = [
  {
    name: "Flange Weight Calculator",
    tag: "Most Popular",
    short: "Flange",
    desc: "Weld neck, slip on, blind, socket weld & threaded flanges",
    specs: "Class 150-2500 · NPS 1/2\"-24\" · 5 Types",
    href: "/flange-weight-calculator/",
    icon: "M12 2L2 7v10c0 5.25 3.75 10.15 8 11 4.25-.85 8-5.75 8-11V7l-10-5zm0 2.18l8 4.02V17c0 4.52-3.275 8.7-7 9.55-3.725-.85-7-5.03-7-9.55V8.2l8-4.02zM12 6a4 4 0 100 8 4 4 0 000-8zm0 2a2 2 0 110 4 2 2 0 010-4z",
  },
  {
    name: "Elbow Weight Calculator",
    tag: "B16.9 Fitting",
    short: "Elbow",
    desc: "45° & 90° long radius and short radius elbows",
    specs: "LR / SR · 13 Schedules · SCH 10-XXS",
    href: "/elbow-weight-calculator/",
    icon: "M20 6v8a4 4 0 01-4 4H8a4 4 0 01-4-4v-2a4 4 0 014-4h8a4 4 0 004-4zm0 0V4m0 2h-4",
  },
  {
    name: "Tee Weight Calculator",
    tag: "Smart Validation",
    short: "Tee",
    desc: "Equal & reducing tees with branch/run validation",
    specs: "Equal / Reducing · Auto-validation · B16.9",
    href: "/tee-weight-calculator/",
    icon: "M12 2v8m0 0l4-4m-4 4L8 6M4 14a4 4 0 004 4h8a4 4 0 004-4v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2z",
  },
  {
    name: "Reducer Weight Calculator",
    tag: "CON / ECC",
    short: "Reducer",
    desc: "Concentric & eccentric butt-weld reducers",
    specs: "CON / ECC · Smart pairing · 20+ Combos",
    href: "/reducer-weight-calculator/",
    icon: "M4 8h16l-4 8H8L4 8zm0 0v8m16-8v8M8 16v2m8-2v2",
  },
];

const features = [
  { title: "ASME B16.5", desc: "Flange dimensions per latest standard" },
  { title: "ASME B16.9", desc: "Butt-weld fitting weights" },
  { title: "13 Schedules", desc: "SCH 10, 20, 30, STD, 40, 60, XS, 80, 100, 120, 140, 160, XXS" },
  { title: "5 Materials", desc: "A105, F304, F316, F11 + custom density" },
  { title: "kg / lb", desc: "Instant unit switching" },
  { title: "Mobile First", desc: "Works on any device" },
];

const stats = [
  { value: "4", label: "Calculators" },
  { value: "50+", label: "Flange Types" },
  { value: "13", label: "Schedules" },
  { value: "100%", label: "Free" },
];

const steps = [
  {
    num: "01",
    title: "Select the fitting",
    desc: "Choose flange, elbow, tee, or reducer and open the matching ASME calculator.",
  },
  {
    num: "02",
    title: "Enter real specs",
    desc: "Input NPS, class, schedule, fitting type, and material density.",
  },
  {
    num: "03",
    title: "Get kg or lb",
    desc: "Copy the theoretical weight for quotations, packing, and shipping plans.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "PVF Calculator",
  "url": canonical,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": canonical + "?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-theme bg-theme-secondary px-4 py-1.5 text-sm font-medium text-theme-secondary">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full accent-bg"></span>
        </span>
        Free Engineering Tools · No Signup · ASME B16.5 / B16.9
      </div>

      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-theme-primary sm:text-5xl lg:text-6xl">
        Pipe Fitting <span class="accent-text">Weight Calculators</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-theme-secondary">
        Professional ASME B16.5 & B16.9 calculators for procurement engineers,
        freight forwarders, and project managers. Trusted by industry professionals worldwide.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="#tools" class="accent-bg hover:opacity-90 rounded-xl px-8 py-3.5 text-sm font-semibold shadow-lg transition" style="color: #07090c;">
          Try the Calculator
        </a>
        <a href="/flange-weight-calculator/" class="rounded-xl border border-theme bg-theme-secondary px-8 py-3.5 text-sm font-semibold text-theme-primary transition hover:bg-theme-tertiary">
          Open Flange Tool
        </a>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 mt-12">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        {stats.map((stat) => (
          <div class="card card-accent relative p-5 text-center">
            <div class="text-3xl font-extrabold text-theme-primary">{stat.value}</div>
            <div class="mt-1 text-sm font-medium text-theme-muted">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools Grid -->
  <section id="tools" class="scroll-mt-24 py-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest accent-text">Free Tools</p>
        <h2 class="mt-2 text-2xl font-bold text-theme-primary sm:text-3xl">Professional Calculators</h2>
        <p class="mt-2 text-theme-secondary">Select a tool to calculate theoretical weights instantly</p>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {tools.map((tool) => (
          <a href={tool.href} class="card card-accent group relative block overflow-hidden">
            <div class="flex items-start justify-between gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl accent-bg shadow-md" style="color: #07090c;">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={tool.icon} />
                </svg>
              </div>
              <span class="rounded-full border border-theme bg-theme-tertiary px-3 py-1 text-xs font-bold uppercase tracking-wider text-theme-muted">
                {tool.tag}
              </span>
            </div>

            <h3 class="mt-5 text-xl font-bold text-theme-primary">{tool.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-theme-secondary">{tool.desc}</p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {tool.specs.split("·").map((spec) => (
                <span class="rounded-md border border-theme bg-theme-tertiary px-2 py-1 text-xs font-medium text-theme-secondary">
                  {spec.trim()}
                </span>
              ))}
            </div>

            <div class="mt-6 flex items-center gap-2 text-sm font-semibold accent-text">
              Open tool
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest accent-text">Process</p>
        <h2 class="mt-2 text-2xl font-bold text-theme-primary sm:text-3xl">How It Works</h2>
        <p class="mt-2 text-theme-secondary">From fitting spec to procurement-ready weight in three steps</p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {steps.map((step) => (
          <div class="card card-accent relative">
            <div class="font-mono text-3xl font-semibold accent-text">{step.num}</div>
            <h3 class="mt-4 text-lg font-bold text-theme-primary">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-theme-secondary">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / SEO Content -->
  <section class="grid gap-6 py-12 lg:grid-cols-2">
    <div class="max-w-6xl mx-auto px-4 lg:col-span-2">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="card card-accent relative">
          <div class="mb-3 flex items-center gap-2">
            <div class="h-8 w-1 rounded-full accent-bg"></div>
            <h2 class="text-lg font-bold text-theme-primary">ASME B16.5 Flange Weights</h2>
          </div>
          <p class="text-sm leading-relaxed text-theme-secondary">
            Calculate theoretical weights for weld neck (WN), slip on (SO), blind (BL), socket weld (SW) and threaded (THD)
            flanges per ASME B16.5. Supports Class 150, 300, 600, 900, 1500 and 2500 pressure ratings in NPS 1/2" through 24".
            Includes A105 carbon steel, F304/F316 stainless steel, and F11 alloy steel with custom density input.
          </p>
          <a href="/flange-weight-calculator/" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold accent-text hover:underline">
            Calculate flange weight
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="card card-accent relative">
          <div class="mb-3 flex items-center gap-2">
            <div class="h-8 w-1 rounded-full accent-bg"></div>
            <h2 class="text-lg font-bold text-theme-primary">ASME B16.9 Fitting Weights</h2>
          </div>
          <p class="text-sm leading-relaxed text-theme-secondary">
            Butt-weld fitting weight calculators for 45°/90° elbows (long & short radius), equal/reducing tees, and
            concentric/eccentric reducers. Covers SCH 10, 20, 30, STD, 40, 60, XS, 80, 100, 120, 140, 160 and XXS schedules
            with automatic geometry validation.
          </p>
          <a href="/elbow-weight-calculator/" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold accent-text hover:underline">
            Calculate fitting weight
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative overflow-hidden rounded-3xl border border-theme bg-theme-secondary p-8 sm:p-10">
        <div class="absolute -top-24 right-0 h-64 w-64 rounded-full bg-amber-400/10 blur-3xl"></div>
        <div class="absolute -bottom-24 left-0 h-64 w-64 rounded-full bg-amber-500/10 blur-3xl"></div>
        <div class="relative">
          <div class="text-center">
            <p class="text-xs font-semibold uppercase tracking-widest accent-text">Why PVFCalculator</p>
            <h2 class="mt-2 text-2xl font-bold text-theme-primary">Built for Engineering Professionals</h2>
            <p class="mt-2 text-theme-secondary">Standards-compliant calculations you can trust</p>
          </div>

          <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
            {features.map((f) => (
              <div class="text-center">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl border border-theme bg-theme-tertiary accent-text">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
                <p class="text-sm font-bold text-theme-primary">{f.title}</p>
                <p class="mt-1 text-xs text-theme-muted">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="card card-accent relative overflow-hidden p-8 text-center sm:p-10">
        <div class="absolute -top-24 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-amber-400/10 blur-3xl"></div>
        <div class="relative">
          <p class="text-xs font-semibold uppercase tracking-widest accent-text">Factory Quotes</p>
          <h2 class="mt-2 text-2xl font-bold text-theme-primary sm:text-3xl">Need Factory Quotes from Cangzhou?</h2>
          <p class="mx-auto mt-3 max-w-xl text-theme-secondary">
            Connect with Hebei pipe fitting manufacturers for competitive pricing.
            Free quotes within 24 hours from verified suppliers.
          </p>
          <a href="mailto:quotes@pvfcalculator.com" class="mt-6 inline-flex items-center gap-2 accent-bg hover:opacity-90 rounded-xl px-8 py-3.5 text-sm font-bold shadow-lg transition" style="color: #07090c;">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Request Factory Quote
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
