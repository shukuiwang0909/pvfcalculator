        <div class="absolute -bottom-24 left-0 h-64 w-64 rounded-full bg-amber-500/10 blur-3xl"></div>
        <div class="relative">
          <div class="text-center">
            <p class="text-xs font-semibold uppercase tracking-widest accent-text">Why Source From Us</p>
