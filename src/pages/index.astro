        <div class="glass rounded-xl p-4 text-center">
          <svg class="mx-auto mb-2 h-6 w-6 accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
