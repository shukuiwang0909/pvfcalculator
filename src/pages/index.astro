              <p class="mt-1 text-sm text-theme-secondary">Non-standard sizes, special materials, and OEM fabrication. From single prototypes to container loads.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-6 text-center">
