          <p class="text-sm font-semibold text-theme-primary">Oil &amp; Gas</p>
        </div>
        <div class="glass rounded-xl p-4 text-center">
          <svg class="mx-auto mb-2 h-6 w-6 accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999A5.002 5.002 0 103.1 15H3z" /></svg>
          <p class="text-sm font-semibold text-theme-primary">Petrochemical</p>
