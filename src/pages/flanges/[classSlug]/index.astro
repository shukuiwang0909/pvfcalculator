---
import Base from "../../../layouts/Base.astro";
import flangeData from "../../../data/flange-b165.json";

export async function getStaticPaths() {
  return (flangeData as any).classes.map((cls: any) => ({
    params: { classSlug: cls.slug },
    props: { cls },
  }));
}

type NpsEntry = {
  nps: string;
  slug: string;
  npsMm: number;
  odIn: number;
  bcdIn: number;
  boltCount: number;
  boltSizeIn: string;
  boltHoleDiaIn: number;
  rfOdIn: number;
  minThkIn: number;
  approxKgWN: number;
};

type ClassData = {
  class: number;
  slug: string;
  label: string;
  maxPressureBar: number;
  maxPressurePsi: number;
  approximate: boolean;
  npsEntries: NpsEntry[];
};

type Props = { cls: ClassData };

const { cls } = Astro.props;

const origin = "https://pvfcalculator.com";
const pageUrl = `${origin}/flanges/${cls.slug}/`;
const title = `ASME B16.5 ${cls.label} Flanges — Dimensions by NPS | PVFCalculator`;
const description = `ASME B16.5 ${cls.label} flange dimensions for NPS ${cls.npsEntries[0].nps}" through NPS ${cls.npsEntries[cls.npsEntries.length - 1].nps}". Flange OD, bolt circle, bolt count, and minimum thickness tables.`;

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Flanges", url: "/flanges/" },
  { name: cls.label, url: `/flanges/${cls.slug}/` },
];

const allClasses: ClassData[] = (flangeData as any).classes;
const clsIdx = allClasses.findIndex((c) => c.slug === cls.slug);
const prevClass = clsIdx > 0 ? allClasses[clsIdx - 1] : null;
const nextClass = clsIdx < allClasses.length - 1 ? allClasses[clsIdx + 1] : null;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    url: pageUrl,
    about: { "@type": "Thing", name: "Steel Flange", sameAs: "https://www.wikidata.org/wiki/Q1064965" },
    author: { "@type": "Person", name: "Kevin Wang" },
    publisher: { "@type": "Organization", name: "PVFCalculator", url: origin },
  },
];

function inToMm(val: number): string {
  return (val * 25.4).toFixed(1);
}
---

<Base
  title={title}
  description={description}
  canonical={pageUrl}
  breadcrumbItems={breadcrumbItems}
  jsonLd={jsonLd}
  ogType="article"
>
  <section class="relative overflow-hidden py-16 px-4">
    <div class="max-w-5xl mx-auto">

      <!-- Breadcrumb -->
      <nav class="text-sm text-theme-muted mb-8 flex items-center gap-2 flex-wrap">
        <a href="/" class="hover:text-theme-primary transition-colors">Home</a>
        <span>/</span>
        <a href="/flanges/" class="hover:text-theme-primary transition-colors">Flanges</a>
        <span>/</span>
        <span class="text-theme-primary">{cls.label}</span>
      </nav>

      <!-- Hero -->
      <h1 class="text-3xl md:text-4xl font-bold text-theme-primary mb-4">
        ASME B16.5 {cls.label} Flanges — Dimensions by NPS
      </h1>
      <p class="text-theme-secondary text-lg mb-3 max-w-3xl">
        {cls.label} flanges per ASME B16.5 are rated to <strong class="text-theme-primary">{cls.maxPressureBar} bar ({cls.maxPressurePsi} psi)</strong> at
        ambient temperature for Group 1.1 materials (carbon steel). The table below lists all
        NPS sizes with flange OD, bolt circle diameter (BCD), bolt count, and minimum neck thickness.
        Click any row to view the full dimension table including metric equivalents.
      </p>
      {cls.approximate && (
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-amber-500/30 bg-amber-500/10 text-amber-400 text-sm mb-6">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <span>Reference values only — verify against current ASME B16.5 before engineering use.</span>
        </div>
      )}

      <!-- NPS dimension table -->
      <div class="overflow-x-auto rounded-xl border border-theme mb-12">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-theme bg-theme-secondary">
              <th class="px-4 py-3 text-left text-theme-primary font-semibold whitespace-nowrap">NPS</th>
              <th class="px-4 py-3 text-right text-theme-primary font-semibold whitespace-nowrap">DN</th>
              <th class="px-4 py-3 text-right text-theme-primary font-semibold whitespace-nowrap">OD (in)</th>
              <th class="px-4 py-3 text-right text-theme-primary font-semibold whitespace-nowrap">OD (mm)</th>
              <th class="px-4 py-3 text-right text-theme-primary font-semibold whitespace-nowrap">BCD (in)</th>
              <th class="px-4 py-3 text-right text-theme-primary font-semibold whitespace-nowrap">Bolts</th>
              <th class="px-4 py-3 text-right text-theme-primary font-semibold whitespace-nowrap">Bolt Size</th>
              <th class="px-4 py-3 text-right text-theme-primary font-semibold whitespace-nowrap">Min Thk (in)</th>
              <th class="px-4 py-3 text-left text-theme-primary font-semibold"></th>
            </tr>
          </thead>
          <tbody>
            {cls.npsEntries.map((e, i) => (
              <tr class={`border-b border-theme last:border-0 hover:bg-theme-secondary transition-colors ${i % 2 === 0 ? "" : "bg-theme-secondary/50"}`}>
                <td class="px-4 py-3 font-semibold text-theme-primary whitespace-nowrap">NPS {e.nps}"</td>
                <td class="px-4 py-3 text-right text-theme-secondary">DN {e.npsMm}</td>
                <td class="px-4 py-3 text-right text-theme-secondary">{e.odIn.toFixed(2)}"</td>
                <td class="px-4 py-3 text-right text-theme-secondary">{inToMm(e.odIn)}</td>
                <td class="px-4 py-3 text-right text-theme-secondary">{e.bcdIn.toFixed(2)}"</td>
                <td class="px-4 py-3 text-right text-theme-secondary">{e.boltCount}</td>
                <td class="px-4 py-3 text-right text-theme-secondary">{e.boltSizeIn}"</td>
                <td class="px-4 py-3 text-right text-theme-secondary">{e.minThkIn.toFixed(2)}"</td>
                <td class="px-4 py-3 text-left">
                  <a
                    href={`/flanges/${cls.slug}/${e.slug}/`}
                    class="text-xs accent-text hover:underline whitespace-nowrap font-medium"
                  >
                    Full dims &rarr;
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Materials note -->
      <div class="glass border border-theme rounded-xl p-5 mb-10">
        <h2 class="text-base font-bold text-theme-primary mb-2">Common Materials for {cls.label}</h2>
        <p class="text-theme-secondary text-sm leading-relaxed">
          {cls.label} flanges are commonly produced in <strong class="text-theme-primary">ASTM A105</strong> (carbon steel, forged),
          <strong class="text-theme-primary">ASTM A182 F304 / F316L</strong> (austenitic stainless steel), and
          <strong class="text-theme-primary">ASTM A182 F11 / F22</strong> (chrome-moly alloy steel) for elevated temperature service.
          The appropriate material depends on the fluid, design temperature, and corrosion environment.
          Use the <a href="/flange-weight-calculator/" class="text-theme-accent hover:underline">Flange Weight Calculator</a> to
          estimate unit weights for procurement or shipping.
        </p>
      </div>

      <!-- Prev / Next class navigation -->
      <div class="flex flex-col sm:flex-row gap-4 mb-10">
        {prevClass && (
          <a
            href={`/flanges/${prevClass.slug}/`}
            class="flex-1 glass border border-theme rounded-xl p-4 hover:border-[var(--accent)] transition-colors group"
          >
            <p class="text-xs text-theme-muted mb-1">&larr; Lower class</p>
            <p class="font-semibold text-theme-primary group-hover:accent-text transition-colors">{prevClass.label}</p>
            <p class="text-xs text-theme-secondary mt-0.5">{prevClass.maxPressurePsi} psi / {prevClass.maxPressureBar} bar</p>
          </a>
        )}
        {nextClass && (
          <a
            href={`/flanges/${nextClass.slug}/`}
            class="flex-1 glass border border-theme rounded-xl p-4 hover:border-[var(--accent)] transition-colors group text-right"
          >
            <p class="text-xs text-theme-muted mb-1">Higher class &rarr;</p>
            <p class="font-semibold text-theme-primary group-hover:accent-text transition-colors">{nextClass.label}</p>
            <p class="text-xs text-theme-secondary mt-0.5">{nextClass.maxPressurePsi} psi / {nextClass.maxPressureBar} bar</p>
          </a>
        )}
      </div>

      <!-- Back to hub -->
      <p class="text-sm text-theme-muted">
        <a href="/flanges/" class="hover:text-theme-primary transition-colors">&larr; All ASME B16.5 Classes</a>
      </p>

    </div>
  </section>
</Base>
