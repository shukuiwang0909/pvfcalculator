      <!-- Inputs -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <label for="nps" class="mb-1 block text-sm font-semibold text-theme-secondary">Nominal Size (NPS)</label>
          <select id="nps" class="field w-full rounded-lg px-3 py-2 text-sm"></select>
        </div>
        <div>
          <label for="schedule" class="mb-1 block text-sm font-semibold text-theme-secondary">Schedule</label>
          <select id="schedule" class="field w-full rounded-lg px-3 py-2 text-sm">
            <option value="SCH10">SCH 10</option>
            <option value="SCH20">SCH 20</option>
            <option value="SCH30">SCH 30</option>
            <option value="STD">SCH STD</option>
            <option value="SCH40" selected>SCH 40</option>
            <option value="SCH60">SCH 60</option>
            <option value="SCH80">SCH 80</option>
            <option value="XS">SCH XS</option>
