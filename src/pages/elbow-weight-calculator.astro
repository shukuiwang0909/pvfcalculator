---
import Base from '../layouts/Base.astro';
const title = "Pipe Elbow Weight Calculator | 45° & 90° LR/SR Elbow Weight | pvfcalculator.com";
const description = "Calculate 90° and 45° elbow weight (LR/SR). ASME B16.9 elbow weight calculator for carbon steel, stainless steel, alloy steel. Free online.";
const canonical = "https://pvfcalculator.com/elbow-weight-calculator/";

const faqs = [
  {
    q: "How do you calculate the weight of a 90° pipe elbow?",
    a: "Elbow weight is estimated from the ASME B16.9 center-to-end dimension (1.5 × NPS for a long-radius 90° elbow, 1.0 × NPS for short radius, 0.625 × NPS for a 45° elbow) multiplied by the pipe weight per unit length from the ASME B36.10M schedule tables, then scaled for material density. This calculator uses that method calibrated against manufacturer catalog weights, so results typically land within ±10% of supplier quotations for carbon steel butt-weld elbows."
  },
  {
    q: "How much does a 6 inch SCH 40 long radius 90° elbow weigh?",
    a: "A 6\" (NPS 6) SCH 40 long-radius 90° butt-weld elbow in carbon steel (ASTM A234 WPB) weighs approximately 18 kg (about 40 lb). The same elbow in SCH 80 weighs approximately 28 kg, in 304 stainless steel roughly 18.3 kg, and the short-radius version roughly 12.6 kg."
  },
  {
    q: "What is the difference between long radius and short radius elbow weight?",
    a: "A short-radius (SR) 90° elbow has a center-to-end dimension of 1.0 × NPS versus 1.5 × NPS for long radius (LR), so its bend arc is shorter and it carries less metal — typically about 70% of the LR weight for the same NPS and schedule. SR elbows are used only where space is tight; LR is the ASME B16.9 default. Note that ASME B16.9 does not define SR 45° elbows — 45° elbows are long radius only."
  },
  {
    q: "How much lighter is a 45° elbow than a 90° elbow?",
    a: "A 45° elbow weighs roughly 60% of an equivalent 90° long-radius elbow of the same NPS and schedule, because its center-to-end dimension is 0.625 × NPS versus 1.5 × NPS and the bend arc carries proportionally less metal. For example, a 4\" SCH 40 LR elbow is about 8.0 kg as 90° and about 4.8 kg as 45°."
  },
  {
    q: "Which standard covers butt-weld elbow dimensions and weights?",
    a: "ASME B16.9 covers factory-made wrought butt-welding fittings — including 90° and 45°, long- and short-radius elbows — in NPS 1/2\" through 48\". It defines the center-to-end dimensions (A, B) and tolerances, while wall thicknesses follow the pipe schedule tables of ASME B36.10M (carbon steel) and B36.19M (stainless steel). Actual fitting weights vary slightly between manufacturers because B16.9 allows tolerances on wall thickness and center-to-end."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Pipe Elbow Weight Calculator (ASME B16.9)",
  "url": canonical,
  "applicationCategory": "EngineeringApplication",
  "operatingSystem": "Any (web browser)",
  "description": description,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": { "@type": "Organization", "name": "pvfcalculator.com", "url": "https://pvfcalculator.com/" }
};
---
<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd, appJsonLd]} ctaHref="#tool">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
    <!-- Hero -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-theme-primary sm:text-4xl">
        Pipe Elbow Weight Calculator <span class="accent-text">(ASME B16.9)</span>
      </h1>
      <p class="mt-3 max-w-3xl text-theme-secondary">
        Calculate the theoretical weight of ASME B16.9 butt-weld pipe elbows — 90° and 45°,
        long radius (1.5D) and short radius (1D) — from NPS 1/2″ to 24″ in schedules
        SCH 10 through XXS. Covers carbon steel, stainless steel and alloy steel with
        results in kilograms or pounds.
      </p>
    </div>

    <!-- Tool -->
    <section id="tool" class="card p-4 sm:p-6" aria-label="Elbow weight calculator tool">
      <!-- Angle selector -->
      <div class="mb-5">
        <label class="mb-2 block text-sm font-semibold text-theme-secondary">Elbow Angle</label>
        <div class="grid grid-cols-2 gap-2" id="angleButtons">
          <button data-angle="90" class="angle-btn flex flex-col items-center gap-1 rounded-xl border-2 p-3 text-center transition">
            <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><path d="M8 38 L8 16 A16 16 0 0 1 24 32 L56 32" fill="none" stroke="currentColor" stroke-width="3"/><path d="M8 38 L8 32 M56 38 L56 32" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/></svg>
            <span class="text-xs font-semibold">90° Elbow</span>
          </button>
          <button data-angle="45" class="angle-btn flex flex-col items-center gap-1 rounded-xl border-2 p-3 text-center transition">
            <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><path d="M8 38 L8 30 A22 22 0 0 1 22 16 L56 16" fill="none" stroke="currentColor" stroke-width="3"/><path d="M8 38 L8 34 M56 24 L56 20" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/></svg>
            <span class="text-xs font-semibold">45° Elbow</span>
          </button>
        </div>
        <p class="mt-1 text-xs text-theme-muted" id="angleDesc">Quarter bend — full right-angle change of direction</p>
      </div>

      <!-- Radius selector -->
      <div class="mb-5">
        <label class="mb-2 block text-sm font-semibold text-theme-secondary">Radius Type</label>
        <div class="grid grid-cols-2 gap-2" id="radiusButtons">
          <button data-radius="LR" class="radius-btn flex flex-col items-center gap-1 rounded-xl border-2 p-3 text-center transition">
            <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><path d="M8 38 L8 22 A16 16 0 0 1 24 38" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3"/><path d="M8 38 L8 12 A26 26 0 0 1 34 38 L56 38" fill="none" stroke="currentColor" stroke-width="3"/></svg>
            <span class="text-xs font-semibold">Long Radius (1.5D)</span>
