---
import Base from "../../layouts/Base.astro";
import FaqJsonLd from "../../components/FaqJsonLd.astro";

const title = "ASME B16.9 Equal Tee & Reducing Tee — Buttweld Pipe Tee";
const description =
  "ASME B16.9 buttweld pipe tees: equal tees and reducing tees for all schedules NPS ½\"–48\". Dimensions, materials, weight calculator, and inquiry.";
const canonical = "https://pvfcalculator.com/products/equal-tee/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "ASME B16.9 Pipe Tee",
  description,
  url: canonical,
  brand: { "@type": "Organization", name: "PVF Calculator" },
};
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Products", url: "/products/" },
  { name: "Pipe Tee", url: "/products/equal-tee/" },
];
const faqItems = [
  {
    question: "What is an equal tee vs a reducing tee?",
    answer: "An equal tee has all three openings at the same nominal size (e.g., 6\" × 6\" × 6\"). A reducing tee has a smaller branch outlet — for example, 6\" × 6\" × 4\" means the two run openings are 6\" and the branch outlet is 4\". Reducing tees are specified when the branch flow is smaller than the main run.",
  },
  {
    question: "How is a pipe tee weight calculated?",
    answer: "A buttweld tee weight is calculated by modeling the run barrel (two ends at run NPS) and the branch reinforcement (outlet at branch NPS) as geometric solids, then computing volume × material density. Our tee weight calculator does this using ASME B16.9 center-to-end dimensions for your selected NPS, schedule, and material.",
  },
  {
    question: "What is the minimum wall thickness of a reducing tee?",
    answer: "ASME B16.9 requires the minimum wall thickness of finished fittings to be not less than 87.5% of the specified schedule wall thickness (same as the connected pipe). The actual wall at the branch crotch is typically thicker due to the forming process.",
  },
];
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd} breadcrumbItems={breadcrumbItems} ctaHref="/tee-weight-calculator/">
  <section class="relative overflow-hidden py-14 sm:py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <nav class="text-sm text-theme-muted mb-6 flex items-center gap-2 flex-wrap">
        <a href="/" class="hover:text-theme-primary">Home</a>
        <span>/</span>
        <span class="text-theme-primary">Pipe Tee</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-theme-primary mb-4">
        Pipe <span class="accent-text">Tee</span> (ASME B16.9)
      </h1>
      <p class="text-lg text-theme-secondary max-w-2xl leading-relaxed">
        Buttweld equal tees and reducing tees to ASME B16.9. NPS ½"–48", all schedules. Available in carbon steel, stainless, alloy, and duplex grades.
      </p>
    </div>
  </section>

  <section class="py-8 px-4">
    <div class="max-w-4xl mx-auto space-y-12">

      <div>
        <h2 class="text-2xl font-bold text-theme-primary mb-4">Specifications</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-theme bg-theme-secondary">
                <th class="px-4 py-3 text-left font-semibold text-theme-primary">Parameter</th>
                <th class="px-4 py-3 text-left font-semibold text-theme-primary">Value</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-theme/50"><td class="px-4 py-2 text-theme-secondary">Standard</td><td class="px-4 py-2 text-theme-secondary">ASME B16.9</td></tr>
              <tr class="border-b border-theme/50 bg-theme/30"><td class="px-4 py-2 text-theme-secondary">Types</td><td class="px-4 py-2 text-theme-secondary">Equal tee, Reducing tee (run × run × branch)</td></tr>
              <tr class="border-b border-theme/50"><td class="px-4 py-2 text-theme-secondary">Size range</td><td class="px-4 py-2 text-theme-secondary">NPS ½" to 48"</td></tr>
              <tr class="border-b border-theme/50 bg-theme/30"><td class="px-4 py-2 text-theme-secondary">Wall thickness</td><td class="px-4 py-2 text-theme-secondary">Per ASME B36.10M / B36.19M schedule</td></tr>
              <tr class="border-b border-theme/50"><td class="px-4 py-2 text-theme-secondary">End preparation</td><td class="px-4 py-2 text-theme-secondary">Beveled ends per ASME B16.25</td></tr>
              <tr class="border-b border-theme/50 bg-theme/30"><td class="px-4 py-2 text-theme-secondary">Tolerances</td><td class="px-4 py-2 text-theme-secondary">Per ASME B16.9 Table 6 (end-to-center, outside diameter)</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-theme-primary mb-4">Materials</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          <div class="glass rounded-xl p-4"><p class="font-semibold accent-text">Carbon Steel</p><p class="text-sm text-theme-secondary mt-1">A234 WPB, WPC</p></div>
          <div class="glass rounded-xl p-4"><p class="font-semibold accent-text">Stainless Steel</p><p class="text-sm text-theme-secondary mt-1">A403 WP304/L, WP316/L, WP321</p></div>
          <div class="glass rounded-xl p-4"><p class="font-semibold accent-text">Alloy Steel</p><p class="text-sm text-theme-secondary mt-1">A234 WP11, WP22, WP91</p></div>
          <div class="glass rounded-xl p-4"><p class="font-semibold accent-text">Duplex</p><p class="text-sm text-theme-secondary mt-1">F51, F53 — sour service and offshore</p></div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-theme-primary mb-4">Applications</h2>
        <ul class="space-y-2 text-theme-secondary">
          <li class="flex gap-3"><span class="accent-text font-bold shrink-0">→</span><span>Distribution manifolds in process plants — branching main headers to equipment</span></li>
          <li class="flex gap-3"><span class="accent-text font-bold shrink-0">→</span><span>Utility headers (steam, CW, process water) where spur connections are required</span></li>
          <li class="flex gap-3"><span class="accent-text font-bold shrink-0">→</span><span>Firewater loops and pressure relief routing</span></li>
          <li class="flex gap-3"><span class="accent-text font-bold shrink-0">→</span><span>Subsea pipelines — reducing tees for riser and PLET connections</span></li>
        </ul>
      </div>

      <div class="card card-accent p-8 text-center">
        <h2 class="text-2xl font-bold text-theme-primary mb-3">Calculate Tee Weight</h2>
        <p class="text-theme-secondary mb-6">Select run size, branch size, schedule, and material for ASME B16.9-compliant weight calculation.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/tee-weight-calculator/" class="inline-flex items-center gap-2 accent-bg hover:opacity-90 rounded-xl px-8 py-3.5 text-sm font-bold shadow-lg transition" style="color: #07090c;">
            Tee Weight Calculator →
          </a>
          <a href="/request-a-quote/" class="inline-flex items-center gap-2 rounded-xl border border-theme px-8 py-3.5 text-sm font-bold text-theme-primary hover:bg-theme-secondary transition">
            Request a Quote
          </a>
        </div>
      </div>

      <div id="faq">
        <h2 class="text-2xl font-bold text-theme-primary mb-6">FAQ</h2>
        <div class="space-y-4">
          {faqItems.map(item => (
            <details class="glass rounded-xl px-5 py-4 group">
              <summary class="flex items-center justify-between cursor-pointer font-semibold text-theme-primary">
                {item.question}
                <svg class="h-5 w-5 accent-text transition-transform group-open:rotate-180 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-theme-secondary">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<FaqJsonLd items={faqItems} />
