---
import Base from '../layouts/Base.astro';
const title = "Pipe Tee Weight Calculator | Equal & Reducing Tee Weight";
const description = "Calculate equal and reducing tee weight. ASME B16.9 tee weight calculator for carbon steel, stainless steel, alloy steel. Free online.";
const canonical = "https://pvfcalculator.com/tee-weight-calculator/";

const faqs = [
  {
    q: "How do you calculate the weight of a pipe tee?",
    a: "Tee weight is estimated from the ASME B16.9 center-to-end dimension (C = NPS for the run, C1 = branch NPS for reducing tees) combined with the pipe weight per unit length from the ASME B36.10M schedule tables. Because of the extra metal at the branch intersection, an equal tee weighs approximately 1.5 × the straight-pipe weight of the same size and schedule, while a reducing tee weighs approximately 1.3 × the straight-pipe weight of the run size. This calculator uses catalog-calibrated SCH 40 reference weights with schedule and material-density factors, so results typically land within ±10% of supplier quotations for carbon steel butt-weld tees."
  },
  {
    q: "How much does a 6 inch SCH 40 equal tee weigh?",
    a: "A 6\" (NPS 6) SCH 40 equal butt-weld tee in carbon steel (ASTM A234 WPB) weighs approximately 22 kg (about 48.5 lb). The same tee in SCH 80 weighs approximately 33 kg, in SCH 10 approximately 12 kg, and in 304 stainless steel roughly 22.4 kg. A reducing tee such as 6\" × 4\" SCH 40 weighs approximately 19 kg, about 13% lighter than the equal tee because the branch outlet carries less metal."
  },
  {
    q: "What is the difference between an equal tee and a reducing tee?",
    a: "An equal tee has all three ends at the same nominal pipe size — two run ends and a branch outlet of identical bore. A reducing tee has a branch outlet smaller than the run (for example 6\" × 4\"), used where a smaller line branches off a larger header. Per ASME B16.9 the branch of a reducing tee must be smaller than the run, and the center-to-end dimensions are C = run NPS and C1 = branch NPS. Reducing tees are lighter than equal tees of the run size: roughly 1.3 × versus 1.5 × the straight-pipe weight."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Pipe Tee Weight Calculator (ASME B16.9)",
  "url": canonical,
  "applicationCategory": "EngineeringApplication",
  "operatingSystem": "Any (web browser)",
  "description": description,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": { "@type": "Organization", "name": "pvfcalculator.com", "url": "https://pvfcalculator.com/" }
};
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Tee Weight Calculator", url: "/tee-weight-calculator/" },
];
---
<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd, appJsonLd]} breadcrumbItems={breadcrumbItems} ctaHref="#tool">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
    <!-- Hero -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-theme-primary sm:text-4xl">
        Pipe Tee Weight Calculator <span class="accent-text">(ASME B16.9)</span>
      </h1>
      <p class="mt-3 max-w-3xl text-theme-secondary">
        Calculate the theoretical weight of ASME B16.9 butt-weld pipe tees — equal tees
        (all ends the same NPS) and reducing tees (smaller branch outlet) — from NPS 1/2″
        to 24″ in schedules SCH 10 through XXS. Covers carbon steel, stainless steel and
        alloy steel with results in kilograms or pounds.
      </p>
    </div>

    <!-- Tool -->
    <section id="tool" class="card p-4 sm:p-6" aria-label="Tee weight calculator tool">
      <!-- Tee type selector (radio cards) -->
      <div class="mb-5">
        <label class="mb-2 block text-sm font-semibold text-theme-secondary">Tee Type</label>
        <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Tee type">
          <label class="cursor-pointer">
            <input type="radio" name="teeType" value="EQ" class="peer sr-only" checked />
            <span class="flex flex-col items-center gap-1 rounded-xl border-2 border-theme p-3 text-center text-theme-secondary transition peer-checked:accent-border peer-checked:accent-light-bg peer-checked:accent-text peer-focus-visible:ring-2 peer-focus-visible:ring-orange-400">
              <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><path d="M25 4 L25 16 Q25 22 31 22 L33 22 Q39 22 39 16 L39 4" fill="none" stroke="currentColor" stroke-width="2.5"/><rect x="4" y="22" width="56" height="14" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
              <span class="text-xs font-semibold">Equal Tee</span>
            </span>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="teeType" value="RED" class="peer sr-only" />
            <span class="flex flex-col items-center gap-1 rounded-xl border-2 border-theme p-3 text-center text-theme-secondary transition peer-checked:accent-border peer-checked:accent-light-bg peer-checked:accent-text peer-focus-visible:ring-2 peer-focus-visible:ring-orange-400">
              <svg viewBox="0 0 64 40" class="h-8 w-14" aria-hidden="true"><path d="M29 4 L29 16 Q29 22 32 22 Q35 22 35 16 L35 4" fill="none" stroke="currentColor" stroke-width="2.5"/><rect x="4" y="22" width="56" height="14" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
              <span class="text-xs font-semibold">Reducing Tee</span>
            </span>
          </label>
        </div>
        <p class="mt-1 text-xs text-theme-muted" id="typeDesc">All three ends the same NPS — run and branch identical</p>
      </div>

      <!-- Inputs -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <label for="runNps" class="mb-1 block text-sm font-semibold text-theme-secondary">Run Size (NPS)</label>
          <select id="runNps" class="field w-full rounded-lg px-3 py-2 text-sm"></select>
        </div>
        <div>
          <label for="branchNps" class="mb-1 block text-sm font-semibold text-theme-secondary">Branch Size (NPS)</label>
          <select id="branchNps" class="field w-full rounded-lg px-3 py-2 text-sm disabled:cursor-not-allowed disabled:bg-theme-tertiary disabled:text-theme-muted"></select>
          <p class="mt-1 hidden text-xs font-medium accent-text" id="branchNote">Branch size must be smaller than the run size.</p>
        </div>
        <div>
          <label for="schedule" class="mb-1 block text-sm font-semibold text-theme-secondary">Schedule</label>
          <select id="schedule" class="field w-full rounded-lg px-3 py-2 text-sm">
            <option value="SCH10">SCH 10</option>
            <option value="SCH20">SCH 20</option>
            <option value="SCH30">SCH 30</option>
            <option value="STD">SCH STD</option>
            <option value="SCH40" selected>SCH 40</option>
            <option value="SCH60">SCH 60</option>
            <option value="SCH80">SCH 80</option>
            <option value="XS">SCH XS</option>
            <option value="SCH100">SCH 100</option>
            <option value="SCH120">SCH 120</option>
            <option value="SCH140">SCH 140</option>
            <option value="SCH160">SCH 160</option>
            <option value="XXS">SCH XXS</option>
          </select>
        </div>
        <div>
          <label for="material" class="mb-1 block text-sm font-semibold text-theme-secondary">Material</label>
          <select id="material" class="field w-full rounded-lg px-3 py-2 text-sm"></select>
        </div>
        <div>
          <label for="density" class="mb-1 block text-sm font-semibold text-theme-secondary">Density (kg/m³)</label>
          <input id="density" type="number" min="1000" max="12000" step="10" value="7850"
            class="field w-full rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="qty" class="mb-1 block text-sm font-semibold text-theme-secondary">Quantity</label>
          <input id="qty" type="number" min="1" max="99999" step="1" value="1"
            class="field w-full rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-theme-secondary">Units</label>
          <div class="flex overflow-hidden rounded-lg border border-theme" role="group" aria-label="Unit system">
            <button id="unitKg" class="unit-btn flex-1 px-3 py-2 text-sm font-semibold transition">kg</button>
            <button id="unitLb" class="unit-btn flex-1 px-3 py-2 text-sm font-semibold transition">lb</button>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
        <div class="result-panel rounded-xl p-5 lg:col-span-1">
          <p class="text-xs font-medium uppercase tracking-wider text-theme-muted">Single Tee Weight</p>
          <p class="mt-2 text-4xl font-extrabold tabular-nums">
            <span id="weightValue">–</span>
            <span class="ml-1 text-xl font-semibold accent-text" id="weightUnit">kg</span>
          </p>
          <p class="mt-3 text-sm text-theme-secondary">
            <span id="resultLine">–</span>
          </p>
          <div class="mt-4 border-t border-theme pt-3 text-sm">
            <div class="flex justify-between py-1"><span class="text-theme-muted">Quantity</span><span class="font-semibold" id="outQty">1</span></div>
            <div class="flex justify-between py-1"><span class="text-theme-muted">Total weight</span><span class="font-semibold accent-text" id="totalWeight">–</span></div>
            <div class="flex justify-between py-1"><span class="text-theme-muted">Run pipe OD</span><span class="font-semibold" id="outRunOd">–</span></div>
            <div class="flex justify-between py-1"><span class="text-theme-muted">Branch pipe OD</span><span class="font-semibold" id="outBranchOd">–</span></div>
          </div>
        </div>

        <div class="card lg:col-span-1">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-theme-muted">Key Dimensions (ASME B16.9)</p>
          <dl class="text-sm" id="dimsList"></dl>
        </div>

        <div class="card lg:col-span-1">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-theme-muted">Calculation Basis</p>
          <dl class="text-sm" id="basisList"></dl>
          <details class="mt-3 text-xs text-theme-muted">
            <summary class="cursor-pointer font-medium accent-text hover:underline">Data source</summary>
            <p class="mt-1">Center-to-end dimensions per ASME B16.9 (equal tee C = NPS; reducing tee C = run NPS, C1 = branch NPS). Reference weights are manufacturer-catalog equal-tee values for SCH 40 carbon steel; SCH 80 / XS = × 1.5 and other schedules use ASME B36.10M metal-mass factors; NPS 14″–24″ extrapolate ∝ NPS². Reducing tees are estimated from the run size (≈ 1.3 × straight-pipe weight vs 1.5 × for equal tees). Weights are theoretical — verify with the fitting manufacturer for critical applications.</p>
          </details>
        </div>
      </div>
      <!-- Copy & Share -->
      <div class="mt-4 flex gap-3 justify-end">
        <button id="copyBtn" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-theme bg-theme px-4 py-2 text-sm font-semibold text-theme-primary transition hover:bg-theme-secondary">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          <span id="copyBtnLabel">Copy Result</span>
        </button>
        <button id="shareBtn" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-theme bg-theme px-4 py-2 text-sm font-semibold text-theme-primary transition hover:bg-theme-secondary">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
          <span id="shareBtnLabel">Share Link</span>
        </button>
      </div>
    </section>

    <!-- Full weight table -->
    <section class="mt-10" aria-label="Tee weight table">
      <h2 class="mb-3 text-xl font-bold text-theme-primary">ASME B16.9 <span id="tableTitle" class="accent-text">Equal Tee</span> Weights — <span id="tableSchedule">SCH 40</span></h2>
      <div class="overflow-x-auto rounded-xl bg-theme-card shadow-md">
        <table class="w-full min-w-[680px] text-sm">
          <thead class="bg-ink-900 text-left text-xs uppercase tracking-wider text-theme-secondary">
            <tr>
              <th class="px-3 py-2.5">Run NPS</th>
              <th class="px-3 py-2.5">Center-to-End C (mm)</th>
              <th class="px-3 py-2.5">Run OD (mm)</th>
              <th class="px-3 py-2.5 text-right">SCH 40 / STD</th>
              <th class="px-3 py-2.5 text-right">SCH 80 / XS</th>
              <th class="px-3 py-2.5 text-right">SCH 160</th>
              <th class="px-3 py-2.5 text-right">SCH XXS</th>
            </tr>
          </thead>
          <tbody id="weightTableBody" class="divide-y divide-theme"></tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-theme-muted">Table weights use the currently selected material density and <span id="tableCaption">equal tee</span> geometry. Tap any row to load it into the calculator.</p>
    </section>

    <!-- Methodology -->
    <section class="mt-12" aria-label="Calculation methodology">
      <h2 class="mb-3 text-xl font-bold text-theme-primary">How the calculation works <span class="accent-text">(center-to-end × weight-per-length, catalog-calibrated)</span></h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="card">
          <svg viewBox="0 0 420 240" class="w-full" role="img" aria-label="Pipe tee geometric model">
            <defs>
              <marker id="arrT" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="#64748b" />
              </marker>
            </defs>
            <!-- run pipe -->
            <rect x="30" y="130" width="360" height="70" fill="#fed7aa" opacity="0.5" stroke="#c2410c" stroke-width="2" />
            <!-- branch -->
            <rect x="175" y="30" width="70" height="100" fill="#fed7aa" opacity="0.5" stroke="#c2410c" stroke-width="2" />
            <!-- reinforcement zone -->
            <rect x="160" y="115" width="100" height="30" fill="#fb923c" opacity="0.45" stroke="#c2410c" stroke-width="1" stroke-dasharray="4 3" />
            <!-- centerlines -->
            <line x1="10" y1="165" x2="410" y2="165" stroke="#475569" stroke-width="1.5" stroke-dasharray="6 5" />
            <line x1="210" y1="10" x2="210" y2="130" stroke="#475569" stroke-width="1.5" stroke-dasharray="6 5" />
            <!-- dim C horizontal -->
            <line x1="210" y1="190" x2="390" y2="190" stroke="#64748b" marker-start="url(#arrT)" marker-end="url(#arrT)" />
            <text x="300" y="208" font-size="12" fill="#334155" text-anchor="middle">C = NPS (run, center-to-end)</text>
            <!-- dim C1 vertical -->
            <line x1="140" y1="30" x2="140" y2="130" stroke="#64748b" marker-start="url(#arrT)" marker-end="url(#arrT)" />
            <text x="80" y="82" font-size="12" fill="#334155" text-anchor="middle">C1</text>
            <text x="210" y="52" font-size="11" fill="#9a3412" text-anchor="middle">Branch outlet</text>
            <text x="300" y="152" font-size="11" fill="#9a3412">Run pipe</text>
            <text x="210" y="110" font-size="10" fill="#92400e" text-anchor="middle">Reinforcement</text>
          </svg>
        </div>
        <div class="card text-sm leading-relaxed text-theme-secondary">
          <p class="font-semibold text-theme-primary">Tee weight equations (ASME B16.9 + ASME B36.10M)</p>
          <ul class="mt-2 list-disc space-y-1.5 pl-5">
            <li><strong>Center-to-end:</strong> equal tee C = NPS in · reducing tee C = run NPS in, C1 = branch NPS in</li>
            <li><strong>Base method:</strong> W = metal volume at the run &amp; branch × density, anchored on pipe weight per unit length from the schedule table</li>
            <li><strong>Equal tee:</strong> W ≈ 1.5 × straight-pipe weight (same NPS &amp; schedule) — the branch intersection adds ≈ ½ pipe length of metal</li>
            <li><strong>Reducing tee:</strong> W ≈ 1.3 × straight-pipe weight of the <strong>run</strong> size &amp; schedule</li>
            <li><strong>This calculator (catalog-calibrated):</strong> W = W<sub>ref</sub>(NPS<sub>run</sub>, SCH) × F<sub>type</sub> × (ρ / 7,850), with F<sub>type</sub> = 1.0 equal, 1.3/1.5 reducing</li>
          </ul>
          <p class="mt-3">The naive center-to-end × kg/m shortcut <strong>understates</strong> real tee weight because the crotch and the branch-to-run intersection carry significant reinforcement metal. A 6″ SCH 40 equal tee catalogs at about 22 kg versus roughly 14 kg of straight pipe in the same envelope — a <strong>≈ 50% understatement</strong> if the reinforcement is ignored. That is why the engine anchors on manufacturer-catalog equal-tee reference weights.</p>
        </div>
      </div>
    </section>

    <!-- SEO content -->
    <section class="mt-12 space-y-6" aria-label="Tee weight reference guide">
      <div class="card">
        <h2 class="mb-3 text-xl font-bold text-theme-primary">How to Calculate Tee Weight</h2>
        <div class="space-y-3 text-sm leading-relaxed text-theme-secondary">
          <p>To calculate the weight of a butt-weld tee you need five inputs: the tee type (equal or reducing), the run size (NPS), the branch size (reducing tees only, and always smaller than the run per ASME B16.9), the wall schedule, and the material density. Start from the ASME B16.9 center-to-end dimensions — C = NPS for the run of an equal tee, with C1 = branch NPS on a reducing tee — then anchor the estimate on the pipe weight per meter from the ASME B36.10M schedule tables, and finally scale by the ratio of your material density to 7,850 kg/m³ if you are not working in carbon steel.</p>
          <p>In practice, procurement and freight teams use manufacturer catalog weights rather than raw pipe arithmetic, because the branch intersection carries substantial reinforcement metal. A 6″ SCH 40 equal tee catalogs at about 22 kg — roughly 1.5 × the weight of the same length of straight pipe — while a 6″ × 4″ reducing tee catalogs closer to 19 kg, about 1.3 × the run-pipe weight. This calculator combines both approaches: catalog-calibrated SCH 40 reference weights with schedule, tee-type and density factors, so reducing tees automatically come out lighter than equal tees of the run size.</p>
        </div>
      </div>
      <div class="card">
        <h2 class="mb-3 text-xl font-bold text-theme-primary">Tee Weight Formula</h2>
        <div class="space-y-3 text-sm leading-relaxed text-theme-secondary">
          <p>The complete formula used by this calculator is:</p>
          <p class="rounded-lg bg-theme-tertiary px-4 py-3 font-mono text-sm text-theme-secondary">W = W_ref(NPS_run, SCH) × F_type × ρ / 7,850</p>
          <p>where W_ref is the carbon-steel equal-tee catalog weight for the selected run NPS and schedule (SCH STD = SCH 40; SCH XS = SCH 80 at × 1.5), F_type is 1.0 for an equal tee and 1.3/1.5 ≈ 0.867 for a reducing tee, and ρ is the material density in kg/m³. Total weight for a purchase order is simply W × quantity. Worked example: a 4″ SCH 80 stainless F316 (ρ = 7,980) equal tee weighs 10 kg × 1.5 × 7,980 / 7,850 ≈ 15.2 kg, and twenty pieces weigh ≈ 305 kg. The same run size as a 4″ × 2″ reducing tee weighs ≈ 13.2 kg.</p>
        </div>
      </div>
      <div class="card">
        <h2 class="mb-3 text-xl font-bold text-theme-primary">ASME B16.9 Standard</h2>
        <div class="space-y-3 text-sm leading-relaxed text-theme-secondary">
          <p>ASME B16.9, “Factory-Made Wrought Buttwelding Fittings,” is the governing standard for butt-weld tees in sizes NPS 1/2″ through 48″. It defines the center-to-end dimensions (C for the run ends, C1 for the branch of a reducing tee), wall thicknesses by schedule, and dimensional tolerances. Equal tees have all three ends at one NPS; reducing tees have a branch outlet smaller than the run, and the standard requires the branch to be the smaller of the two — a tee with a branch larger than its run is not an ASME B16.9 configuration.</p>
          <p>Wall thicknesses follow ASME B36.10M for carbon and alloy steel (SCH 10, 20, 30, STD, 40, 60, XS, 80, 100, 120, 140, 160, XXS) and ASME B36.19M for stainless steel. Typical materials include ASTM A234 WPB (carbon steel), A403 WP304/WP316 (stainless) and A234 WP11/WP22 (alloy steel). Because B16.9 permits tolerances on wall thickness and center-to-end, individual manufacturer weights can vary by a few percent — always confirm against the supplier’s catalog for exact freight and cost estimates.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-12" aria-label="Frequently asked questions">
      <h2 class="mb-4 text-xl font-bold text-theme-primary">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group card open:shadow-md">
            <summary class="cursor-pointer list-none px-5 py-3.5 text-sm font-semibold text-theme-secondary marker:hidden group-open:accent-text">
              {f.q}
              <span class="float-right text-theme-muted transition group-open:rotate-45 group-open:accent-text">+</span>
            </summary>
            <p class="px-5 pb-4 text-sm leading-relaxed text-theme-secondary">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="mt-12 rounded-xl bg-ink-900 border border-theme p-6 text-theme-primary" aria-label="Related tools">
      <h2 class="mb-3 text-lg font-bold">Related Engineering Tools</h2>
      <div class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <a href="/flange-weight-calculator/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Flange Weight Calculator</a>
        <a href="/elbow-weight-calculator/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Elbow Weight Calculator</a>
        <a href="/reducer-weight-calculator/" class="rounded-lg bg-ink-800 p-3 transition hover:bg-ink-700">→ Reducer Weight Calculator</a>
        <a href="/request-a-quote/" class="rounded-lg accent-bg p-3 font-semibold transition hover:opacity-90 text-ink-950">→ Request a Quote</a>
      </div>
    </section>

    <!-- Disclaimer -->
    <p class="mt-8 disclaimer rounded-lg p-4 text-xs leading-relaxed">
      <strong>Disclaimer:</strong> Calculated weights are theoretical values based on ASME B16.9
      center-to-end dimensions and catalog-calibrated reference weights for carbon steel.
      Actual fitting weights vary between manufacturers due to B16.9 tolerances on wall
      thickness and center-to-end dimensions. For critical applications (lifting, shipping
      cost guarantees, pressure-boundary design), verify with the fitting manufacturer.
    </p>
  
  </div>
</Base>

<script>
  import { MATERIALS, NPS_LIST, SCHEDULES, TEE_TYPES, type TeeType } from '../data/tee-dimensions';
  import { computeTeeWeight } from '../lib/tee-calculations';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const state = {
    type: 'EQ' as TeeType,
    runNps: 2,
    branchNps: 1,
    schedule: 'SCH40',
    density: 7850,
    qty: 1,
    unit: (localStorage.getItem('pvf_unit_pref') === 'lb' ? 'lb' : 'kg') as 'kg' | 'lb',
  };

  const fmt = (v: number, d = 2) =>
    v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });

  function populateRunNps() {
    const sel = $('runNps') as HTMLSelectElement;
    sel.innerHTML = '';
    for (const n of NPS_LIST) {
      const opt = document.createElement('option');
      opt.value = String(n.nps);
      opt.textContent = n.label;
      if (n.nps === state.runNps) opt.selected = true;
      sel.appendChild(opt);
    }
  }

  function populateBranchNps() {
    const sel = $('branchNps') as HTMLSelectElement;
    sel.innerHTML = '';
    if (state.type === 'EQ') {
      const opt = document.createElement('option');
      opt.value = String(state.runNps);
      opt.textContent = 'Same as run (equal tee)';
      sel.appendChild(opt);
      sel.disabled = true;
      $('branchNote').classList.add('hidden');
      return;
    }
    sel.disabled = false;
    const smaller = NPS_LIST.filter((n) => n.nps < state.runNps);
    if (smaller.length === 0) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = '— no smaller size —';
      sel.appendChild(opt);
      $('branchNote').textContent = 'Branch size must be smaller than the run size.';
      $('branchNote').classList.remove('hidden');
      return;
    }
    if (state.branchNps >= state.runNps) {
      state.branchNps = smaller[smaller.length - 1].nps;
    }
    for (const n of smaller) {
      const opt = document.createElement('option');
      opt.value = String(n.nps);
      opt.textContent = n.label;
      if (n.nps === state.branchNps) opt.selected = true;
      sel.appendChild(opt);
    }
    $('branchNote').classList.add('hidden');
  }

  function populateMaterials() {
    const sel = $('material') as HTMLSelectElement;
    sel.innerHTML = '';
    for (const m of MATERIALS) {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = `${m.name} (${m.standard}) — ${m.density} kg/m³`;
      sel.appendChild(opt);
    }
  }

  function setTypeDescription() {
    const t = TEE_TYPES.find((x) => x.id === state.type);
    $('typeDesc').textContent = t ? t.desc : '';
  }

  function setUnitButtons() {
    const on = 'bg-ink-900 text-theme-primary';
    const off = 'bg-theme-card text-theme-secondary hover:bg-theme-tertiary';
    $('unitKg').className = 'unit-btn flex-1 px-3 py-2 text-sm font-semibold transition ' + (state.unit === 'kg' ? on : off);
    $('unitLb').className = 'unit-btn flex-1 px-3 py-2 text-sm font-semibold transition ' + (state.unit === 'lb' ? on : off);
  }

  const scheduleName = (id: string) => SCHEDULES.find((s) => s.id === id)?.name ?? id;

  function renderResult() {
    const r = computeTeeWeight(state.type, state.runNps, state.branchNps, state.schedule, state.density);

    if (!r.valid) {
      $('weightValue').textContent = '–';
      $('weightUnit').textContent = state.unit;
      $('resultLine').textContent = 'Select a branch size smaller than the run size.';
      $('outQty').textContent = String(state.qty);
      $('totalWeight').textContent = '–';
      $('outRunOd').textContent = '–';
      $('outBranchOd').textContent = '–';
      $('dimsList').innerHTML = '';
      $('basisList').innerHTML = '';
      $('branchNote').textContent = 'Branch size must be smaller than the run size.';
      $('branchNote').classList.remove('hidden');
      return;
    }

    const w = state.unit === 'kg' ? r.weightKg : r.weightLb;
    $('weightValue').textContent = fmt(w, w >= 100 ? 1 : 2);
    $('weightUnit').textContent = state.unit;
    const typeName = r.type === 'EQ' ? 'Equal Tee' : `Reducing Tee ${r.runLabel} × ${r.branchLabel}`;
    $('resultLine').textContent =
      `${typeName} ${r.runLabel} ${scheduleName(r.schedule)} · ${MATERIALS.find((m) => m.id === ($('material') as HTMLSelectElement).value)?.name ?? ''}`;
    const total = w * state.qty;
    $('outQty').textContent = String(state.qty);
    $('totalWeight').textContent = `${fmt(total, total >= 100 ? 1 : 2)} ${state.unit}`;
    $('outRunOd').textContent = `${fmt(r.pipeOdMm, 1)} mm`;
    $('outBranchOd').textContent = `${fmt(r.branchPipeOdMm, 1)} mm`;

    const rows: [string, string][] = [
      ['Tee type', r.type === 'EQ' ? 'Equal (ASME B16.9)' : 'Reducing (ASME B16.9)'],
      ['Run size', `${r.runLabel} · OD ${fmt(r.pipeOdMm, 1)} mm`],
      ['Branch size', r.type === 'EQ' ? `${r.runLabel} (same as run)` : `${r.branchLabel} · OD ${fmt(r.branchPipeOdMm, 1)} mm`],
      ['Schedule', scheduleName(r.schedule)],
      ['Center-to-end C (run)', `${fmt(r.centerToEndIn, 3)} in (${fmt(r.centerToEndMm, 1)} mm)`],
      ['Center-to-end C1 (branch)', r.type === 'EQ' ? `${fmt(r.centerToEndIn, 3)} in (same as C)` : `${fmt(r.branchCenterToEndIn, 3)} in (${fmt(r.branchCenterToEndMm, 1)} mm)`],
    ];
    $('dimsList').innerHTML = rows
      .map(([k, v]) => `<div class="flex justify-between border-b border-theme py-1.5"><dt class="text-theme-muted">${k}</dt><dd class="font-semibold text-theme-secondary text-right">${v}</dd></div>`)
      .join('');

    const basis: [string, string][] = [
      ['SCH 40 equal-tee reference (CS)', `${fmt(r.referenceKg, 2)} kg`],
      ['Schedule factor', `× ${fmt(r.scheduleFactor, 2)} vs SCH 40`],
      ['Tee-type factor', `× ${fmt(r.typeFactor, 3)} (${r.type === 'EQ' ? 'equal' : 'reducing'})`],
      ['Density factor', `× ${fmt(state.density / 7850, 3)} (${fmt(state.density, 0)} kg/m³)`],
    ];
    $('basisList').innerHTML = basis
      .map(([k, v]) => `<div class="flex justify-between border-b border-theme py-1.5"><dt class="text-theme-muted">${k}</dt><dd class="font-semibold text-theme-secondary text-right">${v}</dd></div>`)
      .join('') +
      `<div class="flex justify-between py-1.5"><dt class="text-theme-muted">Result</dt><dd class="font-bold accent-text">${fmt(r.weightKg, 2)} kg</dd></div>`;
  }

  function renderTable() {
    const typeName = state.type === 'EQ' ? 'Equal Tee' : `Reducing Tee (run × ${state.branchNps}" branch)`;
    $('tableTitle').textContent = typeName;
    $('tableSchedule').textContent = scheduleName(state.schedule);
    $('tableCaption').textContent = state.type === 'EQ' ? 'equal tee' : `reducing tee ${state.runNps}" × ${state.branchNps}"`;
    const tbody = $('weightTableBody');
    tbody.innerHTML = '';
    for (const n of NPS_LIST) {
      if (state.type === 'RED' && !(state.branchNps < n.nps)) continue;
      const r = computeTeeWeight(state.type, n.nps, state.branchNps, state.schedule, state.density);
      if (!r.valid) continue;
      const w40 = computeTeeWeight(state.type, n.nps, state.branchNps, 'SCH40', state.density);
      const w80 = computeTeeWeight(state.type, n.nps, state.branchNps, 'SCH80', state.density);
      const w160 = computeTeeWeight(state.type, n.nps, state.branchNps, 'SCH160', state.density);
      const wxxs = computeTeeWeight(state.type, n.nps, state.branchNps, 'XXS', state.density);
      const conv = (x: { weightKg: number; weightLb: number }) => (state.unit === 'kg' ? x.weightKg : x.weightLb);
      const cell = (x: { weightKg: number; weightLb: number }, isShown: boolean) =>
        `<td class="px-3 py-2 text-right font-semibold ${isShown ? 'accent-text' : ''}">${fmt(conv(x), conv(x) >= 100 ? 1 : 2)}</td>`;
      const tr = document.createElement('tr');
      tr.className = 'cursor-pointer hover-accent-light';
      tr.innerHTML =
        `<td class="px-3 py-2 font-semibold">${n.label}</td>` +
        `<td class="px-3 py-2">${fmt(r.centerToEndMm, 1)}</td>` +
        `<td class="px-3 py-2">${fmt(r.pipeOdMm, 1)}</td>` +
        cell(w40, state.schedule === 'SCH40' || state.schedule === 'STD') +
        cell(w80, state.schedule === 'SCH80' || state.schedule === 'XS') +
        cell(w160, state.schedule === 'SCH160') +
        cell(wxxs, state.schedule === 'XXS');
      tr.title = `${fmt(state.unit === 'kg' ? r.weightKg : r.weightLb, 2)} ${state.unit} at current settings`;
      tr.addEventListener('click', () => {
        state.runNps = n.nps;
        ($('runNps') as HTMLSelectElement).value = String(n.nps);
        populateBranchNps();
        ($('branchNps') as HTMLSelectElement).value = String(state.branchNps);
        render();
        $('tool').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      tbody.appendChild(tr);
    }
  }

  function render() {
    renderResult();
    renderTable();
  }

  // Events
  document.querySelectorAll<HTMLInputElement>('input[name="teeType"]').forEach((r) =>
    r.addEventListener('change', () => {
      state.type = r.value as TeeType;
      setTypeDescription();
      populateBranchNps();
      ($('branchNps') as HTMLSelectElement).value = String(state.branchNps);
      render();
    })
  );
  $('runNps').addEventListener('change', (e) => {
    state.runNps = Number((e.target as HTMLSelectElement).value);
    populateBranchNps();
    ($('branchNps') as HTMLSelectElement).value = String(state.branchNps);
    render();
  });
  $('branchNps').addEventListener('change', (e) => {
    const v = Number((e.target as HTMLSelectElement).value);
    if (state.type === 'RED' && v >= state.runNps) {
      $('branchNote').textContent = 'Branch size must be smaller than the run size.';
      $('branchNote').classList.remove('hidden');
      return;
    }
    $('branchNote').classList.add('hidden');
    state.branchNps = v;
    render();
  });
  $('schedule').addEventListener('change', (e) => { state.schedule = (e.target as HTMLSelectElement).value; render(); });
  $('material').addEventListener('change', (e) => {
    const m = MATERIALS.find((x) => x.id === (e.target as HTMLSelectElement).value)!;
    state.density = m.density;
    ($('density') as HTMLInputElement).value = String(m.density);
    ($('density') as HTMLInputElement).disabled = m.id !== 'custom';
    render();
  });
  $('density').addEventListener('input', (e) => {
    const v = Number((e.target as HTMLInputElement).value);
    if (v > 0) { state.density = v; render(); }
  });
  $('qty').addEventListener('input', (e) => {
    const v = Math.max(1, Math.floor(Number((e.target as HTMLSelectElement).value) || 1));
    state.qty = v;
    renderResult();
  });
  $('unitKg').addEventListener('click', () => { state.unit = 'kg'; localStorage.setItem('pvf_unit_pref', 'kg'); setUnitButtons(); render(); });
  $('unitLb').addEventListener('click', () => { state.unit = 'lb'; localStorage.setItem('pvf_unit_pref', 'lb'); setUnitButtons(); render(); });

  // Init
  populateMaterials();
  ($('density') as HTMLInputElement).disabled = true;
  populateRunNps();
  setTypeDescription();
  populateBranchNps();
  setUnitButtons();
  render();

  // Copy Result
  $('copyBtn').addEventListener('click', () => {
    const w = ($('weightValue') as HTMLElement).textContent ?? '–';
    const unit = ($('weightUnit') as HTMLElement).textContent ?? '';
    const line = ($('resultLine') as HTMLElement).textContent ?? '';
    const total = ($('totalWeight') as HTMLElement).textContent ?? '–';
    const qty = ($('outQty') as HTMLElement).textContent ?? '1';
    const text = `PVF Calculator — Tee Weight\n${line}\nSingle: ${w} ${unit}  ·  Qty: ${qty}  ·  Total: ${total}\nhttps://pvfcalculator.com/tee-weight-calculator/`;
    navigator.clipboard.writeText(text).then(() => {
      $('copyBtnLabel').textContent = '✓ Copied!';
      setTimeout(() => { $('copyBtnLabel').textContent = 'Copy Result'; }, 2000);
    });
  });

  // Share Link
  $('shareBtn').addEventListener('click', () => {
    const sp = new URLSearchParams({
      type: state.type, runNps: String(state.runNps), branchNps: String(state.branchNps),
      schedule: state.schedule, material: ($('material') as HTMLSelectElement).value,
      density: String(state.density), qty: String(state.qty), unit: state.unit,
    });
    history.replaceState(null, '', '?' + sp.toString());
    navigator.clipboard.writeText(location.href).then(() => {
      $('shareBtnLabel').textContent = '✓ Link copied!';
      setTimeout(() => { $('shareBtnLabel').textContent = 'Share Link'; }, 2000);
    });
  });

  // Restore from URL params on load
  {
    const sp = new URLSearchParams(location.search);
    let changed = false;
    const t = sp.get('type') as TeeType;
    if (t && (['EQ','RED'] as string[]).includes(t)) { state.type = t; setTypeDescription(); document.querySelectorAll<HTMLInputElement>('input[name="teeType"]').forEach((r) => { r.checked = r.value === t; }); changed = true; }
    const rn = Number(sp.get('runNps'));
    if (rn > 0) { state.runNps = rn; ($('runNps') as HTMLSelectElement).value = String(rn); populateBranchNps(); changed = true; }
    const bn = Number(sp.get('branchNps'));
    if (bn > 0) { state.branchNps = bn; ($('branchNps') as HTMLSelectElement).value = String(bn); changed = true; }
    const sch = sp.get('schedule');
    if (sch) { state.schedule = sch; ($('schedule') as HTMLSelectElement).value = sch; changed = true; }
    const mat = sp.get('material');
    if (mat) { const found = MATERIALS.find((m) => m.id === mat); if (found) { ($('material') as HTMLSelectElement).value = mat; state.density = found.density; ($('density') as HTMLInputElement).value = String(found.density); ($('density') as HTMLInputElement).disabled = mat !== 'custom'; changed = true; } }
    const d = Number(sp.get('density'));
    if (d > 0) { state.density = d; ($('density') as HTMLInputElement).value = String(d); changed = true; }
    const q = Number(sp.get('qty'));
    if (q >= 1) { state.qty = Math.max(1, Math.floor(q)); ($('qty') as HTMLInputElement).value = String(state.qty); changed = true; }
    const u = sp.get('unit');
    if (u === 'kg' || u === 'lb') { state.unit = u; setUnitButtons(); changed = true; }
    if (changed) render();
  }
</script>
