---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: unknown | unknown[];
  ctaHref?: string;
  robots?: string;
  gaId?: string;
  gscVerification?: string;
  breadcrumbItems?: Array<{ name: string; url: string }>;
  ogType?: "website" | "article";
  lang?: "en" | "zh";
}

const {
  title,
  description = "Free ASME B16.5 & B16.9 pipe fitting weight calculators for flanges, elbows, tees, and reducers.",
  canonical: canonicalProp,
  jsonLd,
  ctaHref = "#tools",
  robots,
  gaId,
  gscVerification,
  breadcrumbItems,
  ogType = "website",
  lang = "en",
} = Astro.props;

const siteOrigin = "https://pvfcalculator.com";
const GA4_ID = "G-PKFFM8ZL3T";

// Language switching
const rawPath = Astro.url.pathname.replace(/\/?$/, "/");
const isZh = rawPath.startsWith("/zh/");
const enPath = isZh ? rawPath.replace(/^\/zh(?=\/)/, "") || "/" : rawPath;
const zhPath = enPath === "/" ? "/zh/" : `/zh${enPath}`;
const zhModules = import.meta.glob("../pages/zh/**/*.astro");
function toRoute(key: string): string {
  const i = key.indexOf("/pages/");
  let p = key.slice(i + "/pages".length).replace(/\.astro$/, "").replace(/\/index$/, "");
  if (!p.endsWith("/")) p += "/";
  return p || "/";
}
const zhRoutes = new Set(Object.keys(zhModules).map(toRoute));
const hasZhPage = zhRoutes.has(zhPath);
const hasEnPage = !isZh || zhRoutes.has(zhPath);
const langSwitchHref = isZh ? enPath : (hasZhPage ? zhPath : "/zh/");
const langSwitchLabel = isZh ? "EN" : "中文";

const canonical = canonicalProp ?? `${siteOrigin}${rawPath}`;
const ogImage = `${siteOrigin}/og-image.png`;
const currentPath = Astro.url.pathname;

const navGroups = lang === "zh" ? [
  {
    label: "法兰工具",
    items: [
      { href: "/zh/flange-weight-calculator/", label: "法兰重量计算器" },
      { href: "/flange-bolt-chart/", label: "法兰螺栓规格表" },
      { href: "/zh/flange-bolt-torque-calculator/", label: "螺栓扭矩计算器" },
    ],
  },
  {
    label: "管件工具",
    items: [
      { href: "/zh/pipe-weight-calculator/", label: "管道重量计算器" },
      { href: "/pipe-friction-loss-calculator/", label: "管道摩擦损失计算器" },
      { href: "/zh/elbow-weight-calculator/", label: "弯头重量计算器" },
      { href: "/zh/tee-weight-calculator/", label: "三通重量计算器" },
      { href: "/zh/reducer-weight-calculator/", label: "异径管重量计算器" },
    ],
  },
  {
    label: "阀门工具",
    items: [
      { href: "/zh/valve-cv-calculator/", label: "阀门 Cv 计算器" },
      { href: "/zh/valve-weight-calculator/", label: "阀门重量计算器" },
    ],
  },
  {
    label: "工程工具",
    items: [
      { href: "/zh/pressure-vessel-thickness-calculator/", label: "压力容器壁厚计算器" },
    ],
  },
  {
    label: "资源",
    items: [
      { href: "/pipe-schedule-chart/", label: "管道壁厚表" },
      { href: "/asme-b16-5-flange-dimensions/", label: "ASME B16.5 尺寸" },
      { href: "/asme-b16-9-fitting-dimensions/", label: "ASME B16.9 尺寸" },
      { href: "/blog/", label: "技术博客" },
    ],
  },
] : [
  {
    label: "Flange Tools",
    items: [
      { href: "/flange-weight-calculator/", label: "Flange Weight" },
      { href: "/flange-bolt-chart/", label: "Flange Bolt Chart" },
      { href: "/flange-bolt-torque-calculator/", label: "Bolt Torque" },
    ],
  },
  {
    label: "Pipe & Fitting Tools",
    items: [
      { href: "/pipe-weight-calculator/", label: "Pipe Weight" },
      { href: "/pipe-friction-loss-calculator/", label: "Pipe Friction Loss" },
      { href: "/elbow-weight-calculator/", label: "Elbow Weight" },
      { href: "/tee-weight-calculator/", label: "Tee Weight" },
      { href: "/reducer-weight-calculator/", label: "Reducer Weight" },
    ],
  },
  {
    label: "Valve Tools",
    items: [
      { href: "/valve-cv-calculator/", label: "Valve Cv" },
      { href: "/valve-weight-calculator/", label: "Valve Weight" },
    ],
  },
  {
    label: "Engineering",
    items: [
      { href: "/pressure-vessel-thickness-calculator/", label: "Pressure Vessel Thickness" },
    ],
  },
  {
    label: "Resources",
    items: [
      { href: "/pipe-schedule-chart/", label: "Pipe Schedule Chart" },
      { href: "/asme-b16-5-flange-dimensions/", label: "ASME B16.5 Dimensions" },
      { href: "/asme-b16-9-fitting-dimensions/", label: "ASME B16.9 Dimensions" },
      { href: "/blog/", label: "Blog" },
    ],
  },
];

const siteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    "name": "PVF Calculator",
    "url": siteOrigin,
    "logo": `${siteOrigin}/favicon.svg`,
    "description": "Free ASME B16.5/B16.9 pipe fitting weight calculators and factory-direct PVF supplier based in Cangzhou, Hebei, China.",
    "areaServed": "Worldwide",
    "knowsAbout": [
      "ASME B16.5 flange weight calculation",
      "ASME B16.9 pipe fitting weight calculation",
      "pipe schedule wall thickness",
      "industrial piping procurement",
      "flange bolt sizing",
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "sales",
      "url": `${siteOrigin}/request-a-quote/`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    "url": siteOrigin,
    "name": "PVF Calculator",
    "publisher": { "@id": `${siteOrigin}/#organization` },
    "inLanguage": "en",
  },
  ...(breadcrumbItems ? [{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems.map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": item.name,
      "item": `${siteOrigin}${item.url}`,
    })),
  }] : []),
  ...(Array.isArray(jsonLd) ? jsonLd : (jsonLd ? [jsonLd] : [])),
];
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="x-default" href={isZh ? `${siteOrigin}${enPath}` : canonical} />
    <link rel="alternate" hreflang="en" href={isZh ? `${siteOrigin}${enPath}` : canonical} />
    {!isZh && hasZhPage && <link rel="alternate" hreflang="zh" href={`${siteOrigin}${zhPath}`} />}
    {isZh && <link rel="alternate" hreflang="zh" href={canonical} />}
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PVF Calculator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={isZh ? "zh_CN" : "en_US"} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- GA4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
    <script is:inline define:vars={{ GA4_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA4_ID);
    </script>
    <!-- JSON-LD -->
    {siteJsonLd.map(obj => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <!-- Dark mode init (prevents FOUC) -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col relative">
    <div class="tech-grid"></div>
    <header class="glass sticky top-0 z-50 border-b border-theme">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between relative z-10">
        <a href={isZh ? "/zh/" : "/"} class="font-bold text-lg tracking-tight text-theme-primary">
          PVF<span class="accent-text">Calculator</span>
        </a>
        <nav class="hidden md:flex gap-5 text-sm items-center">
          {navGroups.map((g) => {
            const isActive = g.items.some((n) => currentPath === n.href || (n.href !== "/" && currentPath.startsWith(n.href)));
            const linkCls = `transition-colors relative ${isActive ? "accent-text font-semibold" : "text-theme-secondary hover:text-theme-primary"}`;
            return (
              <div class="nav-dropdown relative">
                <button class={`${linkCls} flex items-center gap-1 py-4`} aria-haspopup="true">
                  {g.label}
                  <svg class="h-3 w-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                  {isActive && <span class="absolute -bottom-[1px] left-0 right-0 h-0.5 accent-bg"></span>}
                </button>
                <div class="nav-dropdown-menu absolute left-0 top-full pt-1 z-50">
                  <div class="rounded-xl border border-theme bg-theme-primary shadow-xl py-2 min-w-52">
                    {g.items.map((n) => {
                      const isItemActive = currentPath === n.href || (n.href !== "/" && currentPath.startsWith(n.href));
                      return (
                        <a href={n.href} class={`block px-4 py-2 whitespace-nowrap transition-colors ${isItemActive ? "accent-text font-semibold bg-theme-tertiary" : "text-theme-secondary hover:text-theme-primary hover:bg-theme-tertiary"}`}>
                          {n.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          })}
        </nav>
        <div class="flex items-center gap-2 md:gap-3">
          <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg border border-theme hover:bg-theme-tertiary transition-colors" aria-label="Open menu">
            <svg class="w-5 h-5 text-theme-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
          <button id="theme-toggle" class="p-2 rounded-lg border border-theme hover:bg-theme-tertiary transition-colors" aria-label="Toggle theme">
            <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <svg class="w-4 h-4 block dark:hidden text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
          </button>
          {langSwitchHref && (
            <a href={langSwitchHref} class="hidden sm:inline-flex items-center px-2.5 py-1.5 rounded-lg border border-theme text-xs font-semibold text-theme-secondary hover:text-theme-primary hover:bg-theme-tertiary transition-colors" aria-label="Switch language">
              {langSwitchLabel}
            </a>
          )}
          <a href={isZh ? "/zh/request-a-quote/" : (ctaHref === "/request-a-quote/" ? "/request-a-quote/" : ctaHref)} class="hidden sm:inline-block accent-bg hover:opacity-90 text-sm font-semibold px-3 md:px-4 py-2 rounded-lg transition-colors" style="color: #07090c;">
            {isZh ? "获取报价" : (ctaHref === "/request-a-quote/" ? "Get a Quote" : "Calculate Now")}
          </a>
        </div>
      </div>
    </header>
    <div id="mobile-menu" class="fixed inset-0 z-40 hidden">
      <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
      <div class="absolute top-14 left-0 right-0 bg-theme-primary border-b border-theme shadow-xl">
        <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-1">
          {navGroups.map((g) => (
            <div class="mb-1">
              <p class="px-4 pt-2 pb-1 text-xs font-semibold uppercase tracking-widest text-theme-muted">{g.label}</p>
              {g.items.map((n) => {
                const isActive = currentPath === n.href || (n.href !== "/" && currentPath.startsWith(n.href));
                return (
                  <a href={n.href} class={`mobile-menu-link block py-2.5 pl-6 pr-4 rounded-lg transition-colors text-sm font-medium ${isActive ? "accent-text bg-theme-tertiary" : "text-theme-secondary hover:text-theme-primary hover:bg-theme-tertiary"}`}>{n.label}</a>
                );
              })}
            </div>
          ))}
          <a href={isZh ? "/zh/request-a-quote/" : "/request-a-quote/"} class="mobile-menu-link mt-2 py-3 px-4 rounded-lg accent-bg text-center font-semibold" style="color: #07090c;">
            {isZh ? "立即询价" : "Get a Quote"}
          </a>
          {langSwitchHref && (
            <a href={langSwitchHref} class="mobile-menu-link mt-1 py-2 px-4 rounded-lg border border-theme text-center text-sm font-semibold text-theme-secondary hover:text-theme-primary hover:bg-theme-tertiary transition-colors">
              {langSwitchLabel}
            </a>
          )}
        </nav>
      </div>
    </div>
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <footer class="bg-theme-secondary border-t border-theme text-theme-secondary text-sm mt-16 relative z-10">
      <div class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
        <div>
          <p class="text-theme-primary font-semibold mb-2">PVFCalculator</p>
          <p>Free ASME B16.5 & B16.9 pipe fitting weight calculators for procurement, logistics, and project engineering.</p>
        </div>
        <div>
          <p class="text-theme-primary font-semibold mb-2">Flange Tools</p>
          <ul class="space-y-1">
            <li><a href="/flange-weight-calculator/" class="hover:text-theme-primary transition-colors">Flange Weight Calculator</a></li>
            <li><a href="/flange-bolt-chart/" class="hover:text-theme-primary transition-colors">Flange Bolt Chart</a></li>
            <li><a href="/flange-bolt-torque-calculator/" class="hover:text-theme-primary transition-colors">Bolt Torque Calculator</a></li>
          </ul>
        </div>
        <div>
          <p class="text-theme-primary font-semibold mb-2">Pipe & Fitting Tools</p>
          <ul class="space-y-1">
            <li><a href="/pipe-weight-calculator/" class="hover:text-theme-primary transition-colors">Pipe Weight Calculator</a></li>
            <li><a href="/elbow-weight-calculator/" class="hover:text-theme-primary transition-colors">Pipe Elbow Weight Calculator</a></li>
            <li><a href="/tee-weight-calculator/" class="hover:text-theme-primary transition-colors">Pipe Tee Weight Calculator</a></li>
            <li><a href="/reducer-weight-calculator/" class="hover:text-theme-primary transition-colors">Pipe Reducer Weight Calculator</a></li>
          </ul>
        </div>
        <div>
          <p class="text-theme-primary font-semibold mb-2">Valve & Engineering Tools</p>
          <ul class="space-y-1">
            <li><a href="/valve-cv-calculator/" class="hover:text-theme-primary transition-colors">Valve Cv Calculator</a></li>
            <li><a href="/valve-weight-calculator/" class="hover:text-theme-primary transition-colors">Valve Weight Calculator</a></li>
            <li><a href="/pressure-vessel-thickness-calculator/" class="hover:text-theme-primary transition-colors">Pressure Vessel Thickness</a></li>
          </ul>
        </div>
        <div>
          <p class="text-theme-primary font-semibold mb-2">Resources</p>
          <ul class="space-y-1">
            <li><a href="/blog/" class="hover:text-theme-primary transition-colors">Blog & Guides</a></li>
            <li><a href="/asme-b16-5-flange-dimensions/" class="hover:text-theme-primary transition-colors">ASME B16.5 Dimensions</a></li>
            <li><a href="/asme-b16-9-fitting-dimensions/" class="hover:text-theme-primary transition-colors">ASME B16.9 Dimensions</a></li>
            <li><a href="/pipe-schedule-chart/" class="hover:text-theme-primary transition-colors">Pipe Schedule Chart</a></li>
            <li><a href="/request-a-quote/" class="hover:text-theme-primary transition-colors">Request a Quote</a></li>
          </ul>
          <p class="text-theme-primary font-semibold mb-2 mt-4">Sourcing Clusters</p>
          <ul class="space-y-1">
            <li><a href="/cangzhou-flange-manufacturers/" class="hover:text-theme-primary transition-colors">Cangzhou</a></li>
            <li><a href="/mengcun-pipe-fittings/" class="hover:text-theme-primary transition-colors">Mengcun</a></li>
            <li><a href="/yanshan-flange/" class="hover:text-theme-primary transition-colors">Yanshan</a></li>
            <li><a href="/wenzhou-valve-manufacturers/" class="hover:text-theme-primary transition-colors">Wenzhou</a></li>
          </ul>
        </div>
        <div>
          <p class="text-theme-primary font-semibold mb-2">Legal</p>
          <ul class="space-y-1 mb-3">
            <li><a href="/privacy/" class="hover:text-theme-primary transition-colors">Privacy Policy</a></li>
            <li><a href="/terms/" class="hover:text-theme-primary transition-colors">Terms of Use</a></li>
            <li><a href="/disclaimer/" class="hover:text-theme-primary transition-colors">Disclaimer</a></li>
          </ul>
          <p class="text-xs text-theme-muted">Calculations are theoretical estimates based on ASME B16.5 and ASME B16.9 dimensional data. Verify critical weights with manufacturers before procurement or load planning.</p>
        </div>
      </div>
      <div class="border-t border-theme py-4 text-center text-xs text-theme-muted">
        © 2026 PVF Calculator. Built for engineering professionals.
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
    <script is:inline>
      (function() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const backdrop = document.getElementById('mobile-menu-backdrop');
        const links = document.querySelectorAll('.mobile-menu-link');
        function openMenu() {
          menu.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
        function closeMenu() {
          menu.classList.add('hidden');
          document.body.style.overflow = '';
        }
        btn?.addEventListener('click', () => {
          if (menu.classList.contains('hidden')) { openMenu(); } else { closeMenu(); }
        });
        backdrop?.addEventListener('click', closeMenu);
        links.forEach(l => l.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu();
        });
      })();
    </script>
    <!-- GA4 custom events -->
    <style>
      .nav-dropdown-menu {
        display: none;
      }
      .nav-dropdown:hover > .nav-dropdown-menu,
      .nav-dropdown:focus-within > .nav-dropdown-menu {
        display: block;
      }
    </style>
    <script is:inline>
      (function() {
        function gtagEvent(name, params) {
          if (typeof gtag === 'function') gtag('event', name, params);
        }
        // tool_start: first interaction with a calculator form field
        document.querySelectorAll('select, input[type="number"], input[type="radio"]').forEach(function(el) {
          el.addEventListener('change', function() {
            gtagEvent('tool_start', { tool_name: document.title });
          }, { once: true });
        });
        // tool_complete: result panel becomes visible
        var resultPanels = document.querySelectorAll('.result-panel, #result, #results, [id*="result"]');
        if (resultPanels.length && typeof MutationObserver !== 'undefined') {
          var observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(m) {
              if (m.type === 'childList' && m.addedNodes.length > 0) {
                gtagEvent('tool_complete', { tool_name: document.title });
                observer.disconnect();
              }
            });
          });
          resultPanels.forEach(function(p) { observer.observe(p, { childList: true, subtree: true }); });
        }
        // inquiry_submit
        var form = document.querySelector('form[id="inquiry"], form[name="inquiry"], form');
        if (form) {
          form.addEventListener('submit', function() {
            gtagEvent('inquiry_submit', {});
          });
        }
      })();
    </script>
  </body>
</html>
